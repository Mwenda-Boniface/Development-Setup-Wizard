[Desktop Entry]
Version=1.0
Type=Application
Name=Ghost-Stack
GenericName=Development Environment & Toolchain Orchestrator
Comment=Launch Ghost-Stack Development Orchestrator & System Cleaner
Exec=bash -c 'if command -v ghost-stack >/dev/null 2>&1; then exec qterminal -e ghost-stack || exec x-terminal-emulator -e ghost-stack || exec bash -c ghost-stack; else exec "/home/bonnie/Desktop/setup-wizard/bin/ghost-stack"; fi'
Icon=/home/bonnie/Desktop/setup-wizard/assets/ghost-stack.png
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Keywords=ghost;stack;dev;tools;cleaner;doctor;
