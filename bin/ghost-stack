# --- [06. CORE SYSTEM & DEVOPS / SECURITY] ---
check_git_configured() { command -v git >/dev/null 2>&1 && [ -n "$(git config --global user.name 2>/dev/null)" ]; }
install_git_configured() {
    echo -e "${C_MINT}Configuring Git Global Identity...${C_RESET}"
    read -rp "Enter Full Name: " g_name
    read -rp "Enter GitHub Email: " g_email
    [ -n "$g_name" ] && git config --global user.name "$g_name"
    [ -n "$g_email" ] && git config --global user.email "$g_email"
    git config --global init.defaultBranch main
}

check_github_ssh() { [ -f "$CURRENT_HOME/.ssh/id_ed25519" ]; }
install_github_ssh() {
    echo -e "${C_MINT}Generating Ed25519 SSH Key for GitHub...${C_RESET}"
    local email
    email=$(git config --global user.email 2>/dev/null || echo "developer@example.com")
    mkdir -p "$CURRENT_HOME/.ssh" && chmod 700 "$CURRENT_HOME/.ssh"
    ssh-keygen -t ed25519 -C "$email" -f "$CURRENT_HOME/.ssh/id_ed25519" -N ""
    chmod 600 "$CURRENT_HOME/.ssh/id_ed25519"
    chmod 644 "$CURRENT_HOME/.ssh/id_ed25519.pub"
    echo -e "\n${C_LIGHT_G}Public Key (Copy to https://github.com/settings/keys):${C_RESET}"
    cat "$CURRENT_HOME/.ssh/id_ed25519.pub"
    echo ""
    read -rp "Press [Enter] to test connection..."
    ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -T git@github.com 2>&1 || true
}

check_build_essentials() {
    command -v gcc >/dev/null 2>&1 && command -v clang >/dev/null 2>&1 && command -v cmake >/dev/null 2>&1 && command -v ninja >/dev/null 2>&1
}
install_build_essentials() {
    echo -e "${C_MINT}Installing C/C++ Build Essentials and system headers...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install build-essential clang cmake ninja pkg-config git curl unzip zip
    else
        pkg_install build-essential gcc g++ clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev mesa-utils curl git unzip zip xz-utils
    fi
}

