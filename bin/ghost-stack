#!/usr/bin/env bash
# ==============================================================================
# GHOST-STACK // SYSTEM & TOOLCHAIN ORCHESTRATOR
# Version: 3.1.0
# Author: Mwenda Boniface (https://github.com/Mwenda-Boniface)
# Platform: Linux (Debian, Ubuntu, Kali, Mint, Pop!_OS) & Android (Termux)
# Style: Cyberpunk Terminal Green (Strictly Zero Emojis)
# Architecture: 100% Dynamic User, Multi-User Agnostic, Termux-Compatible
# ==============================================================================

set -o pipefail

# Ensure bash execution
if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

# ==============================================================================
# PLATFORM & ENVIRONMENT RESOLUTION (LINUX / TERMUX)
# ==============================================================================
if [ -z "${IS_TERMUX:-}" ]; then
    IS_TERMUX=false
    if [ -n "$TERMUX_VERSION" ] || [ -d "/data/data/com.termux" ] || [[ "${PREFIX:-}" =~ "com.termux" ]]; then
        IS_TERMUX=true
    fi
fi

CURRENT_USER="$(id -un 2>/dev/null || whoami)"
CURRENT_HOME="${HOME:-/home/$CURRENT_USER}"

REAL_SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$REAL_SCRIPT_PATH")/.." && pwd)"

DEV_DIR="$CURRENT_HOME/development"
FLUTTER_DIR="$DEV_DIR/flutter"
ANDROID_DIR="$CURRENT_HOME/Android/Sdk"

# Architecture detection
ARCH="$(uname -m 2>/dev/null || echo "unknown")"
OS_NAME="Linux"
if [ "$IS_TERMUX" = true ]; then
    OS_NAME="Android (Termux)"
elif [ -f /etc/os-release ]; then
    OS_NAME=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')
fi

# Temporary directory resolution (Termux uses $PREFIX/tmp or $TMPDIR)
TMP_DIR="${TMPDIR:-/tmp}"
if [ "$IS_TERMUX" = true ] || [ ! -w "$TMP_DIR" ]; then
    TMP_DIR="${PREFIX:-$CURRENT_HOME}/tmp"
    [ ! -d "$TMP_DIR" ] && TMP_DIR="$CURRENT_HOME/.tmp"
fi
mkdir -p "$TMP_DIR" 2>/dev/null || true

# Java path resolution
JAVA_21_PATH="/usr/lib/jvm/java-21-openjdk-amd64"
JAVA_17_PATH="/usr/lib/jvm/java-17-openjdk-amd64"
if [ "$IS_TERMUX" = true ]; then
    JAVA_PREFERRED_PATH="${PREFIX:-/data/data/com.termux/files/usr}/lib/jvm/java-17-openjdk"
elif [ -d "$JAVA_21_PATH" ]; then
    JAVA_PREFERRED_PATH="$JAVA_21_PATH"
elif [ -d "$JAVA_17_PATH" ]; then
    JAVA_PREFERRED_PATH="$JAVA_17_PATH"
else
    JAVA_PREFERRED_PATH="/usr/lib/jvm/default-java"
fi

# Package manager abstraction (Debian apt vs Termux pkg)
APT_UPDATED=false
pkg_install() {
    if [ "$IS_TERMUX" = true ]; then
        pkg install -y "$@" || apt-get install -y "$@"
    else
        if [ "$APT_UPDATED" = false ]; then
            echo -e "${C_GRAY}Synchronizing package repositories (apt update)...${C_RESET}"
            sudo apt update && APT_UPDATED=true
        fi
        sudo apt install -y "$@"
    fi
}

# ==============================================================================
# COLOR PALETTE (TERMINAL GREEN // ZERO EMOJIS)
# ==============================================================================
C_LIGHT_G="\033[1;32m"      # Classic vibrant light green
C_MINT="\033[38;5;84m"      # Crisp readable mint green
C_DARK_G="\033[38;5;29m"    # Deep border green
C_WHITE="\033[1;37m"        # High contrast bold white
C_GRAY="\033[38;5;244m"     # Technical muted gray
C_RED="\033[1;31m"          # Failure / missing
C_YELLOW="\033[1;33m"       # Warning / attention
C_CYAN="\033[1;36m"         # Accent cyan
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

# Dynamic Telemetry In-Place Coordinates & Auto-Fit Tier
G_CPU_ROW=""
G_CPU_COL=""
G_RAM_ROW=""
G_RAM_COL=""
G_LAYOUT_TIER="medium"

# Adaptive Status Badges (Strictly Zero Emojis)
get_current_cols() {
    local term_cols="${GHOST_STACK_COLS:-${COLUMNS:-}}"
    if [ -z "$term_cols" ] || [ "$term_cols" -eq 0 ] 2>/dev/null; then
        term_cols=$(tput cols 2>/dev/null || echo 80)
    fi
    echo "$term_cols"
}

get_current_lines() {
    local term_lines="${GHOST_STACK_LINES:-${LINES:-}}"
    if [ -z "$term_lines" ] || [ "$term_lines" -eq 0 ] 2>/dev/null; then
        term_lines=$(tput lines 2>/dev/null || echo 24)
    fi
    echo "$term_lines"
}

badge_ok() {
    local tc
    tc=$(get_current_cols)
    if [ "$tc" -lt 65 ]; then
        echo -e " ${C_LIGHT_G}[OK]${C_RESET} $1"
    else
        echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ]${C_RESET}       $1"
    fi
}
badge_missing() {
    local tc
    tc=$(get_current_cols)
    if [ "$tc" -lt 65 ]; then
        echo -e " ${C_RED}[MISS]${C_RESET} $1"
    else
        echo -e "  ${C_RED}${C_BOLD}[ MISSING ]${C_RESET}  $1"
    fi
}
badge_warn() {
    local tc
    tc=$(get_current_cols)
    if [ "$tc" -lt 65 ]; then
        echo -e " ${C_YELLOW}[WARN]${C_RESET} $1"
    else
        echo -e "  ${C_YELLOW}${C_BOLD}[ WARN ]${C_RESET}     $1"
    fi
}
badge_info() {
    local tc
    tc=$(get_current_cols)
    if [ "$tc" -lt 65 ]; then
        echo -e " ${C_MINT}[INFO]${C_RESET} $1"
    else
        echo -e "  ${C_MINT}${C_BOLD}[ INFO ]${C_RESET}     $1"
    fi
}

draw_divider() {
    local tc
    tc=$(get_current_cols)
    local div_len=$((tc - 4))
    if [ "$div_len" -gt 65 ]; then div_len=65; fi
    if [ "$div_len" -lt 36 ]; then div_len=36; fi
    echo -e "  ${C_GRAY}$(printf "%0.s─" $(seq 1 "$div_len"))${C_RESET}"
}

# ==============================================================================
# ENVIRONMENT & DESKTOP AUTO-STAMPING
# ==============================================================================
sync_env() {
    if [ -d "$JAVA_PREFERRED_PATH" ]; then
        export JAVA_HOME="$JAVA_PREFERRED_PATH"
    fi
    export ANDROID_HOME="$ANDROID_DIR"
    local termux_prefix_bin="${PREFIX:-/data/data/com.termux/files/usr}/bin"
    if [ "$IS_TERMUX" = true ]; then
        export PATH="$CURRENT_HOME/.local/bin:$termux_prefix_bin:$CURRENT_HOME/.cargo/bin:$CURRENT_HOME/go/bin:$CURRENT_HOME/.bun/bin:$CURRENT_HOME/.deno/bin:$FLUTTER_DIR/bin:$ANDROID_DIR/cmdline-tools/latest/bin:$ANDROID_DIR/platform-tools:${JAVA_HOME:-/usr}/bin:$PATH"
    else
        export PATH="$CURRENT_HOME/.local/bin:$CURRENT_HOME/.cargo/bin:$CURRENT_HOME/go/bin:$CURRENT_HOME/.bun/bin:$CURRENT_HOME/.deno/bin:$FLUTTER_DIR/bin:$ANDROID_DIR/cmdline-tools/latest/bin:$ANDROID_DIR/platform-tools:${JAVA_HOME:-/usr}/bin:$PATH"
    fi
}
sync_env

persist_env() {
    local env_block="
# --- GHOST-STACK ENVIRONMENT PATHS (USER: $CURRENT_USER) ---
export JAVA_HOME=\"${JAVA_PREFERRED_PATH}\"
export ANDROID_HOME=\"\$HOME/Android/Sdk\"
export PATH=\"\$HOME/.local/bin:\$HOME/.cargo/bin:\$HOME/go/bin:\$HOME/.bun/bin:\$HOME/.deno/bin:\$HOME/development/flutter/bin:\$ANDROID_HOME/cmdline-tools/latest/bin:\$ANDROID_HOME/platform-tools:\$JAVA_HOME/bin:\$PATH\"
# ----------------------------------------------------------"

    for rc in "$CURRENT_HOME/.zshrc" "$CURRENT_HOME/.bashrc"; do
        if [ -f "$rc" ]; then
            if ! grep -q "GHOST-STACK ENVIRONMENT PATHS" "$rc" && ! grep -q "ANDROID_HOME" "$rc"; then
                echo "$env_block" >> "$rc"
            fi
        fi
    done
}
persist_env

auto_stamp_desktop() {
    if [ "$IS_TERMUX" = true ]; then
        return 0
    fi
    local desktop_targets=(
        "$CURRENT_HOME/Desktop/Ghost-Stack.desktop"
        "$ROOT_DIR/Ghost-Stack.desktop"
        "$CURRENT_HOME/.local/share/applications/ghost-stack.desktop"
    )
    for dt in "${desktop_targets[@]}"; do
        if [ -f "$dt" ] && command -v gio >/dev/null 2>&1; then
            chmod +x "$dt" 2>/dev/null || true
            local sum
            sum=$(sha256sum "$dt" 2>/dev/null | awk '{print $1}')
            if [ -n "$sum" ]; then
                gio set -t string "$dt" metadata::xfce-exe-checksum "$sum" 2>/dev/null || true
            fi
        fi
    done
    rm -f "$CURRENT_HOME/Desktop/Dev-Setup-Wizard.desktop" "$CURRENT_HOME/.local/share/applications/dev-setup-wizard.desktop" 2>/dev/null || true
}
auto_stamp_desktop

# ==============================================================================
# UI RENDERERS & TELEMETRY
# ==============================================================================
get_layout_tier() {
    if [ "$IS_TERMUX" = true ]; then
        echo "mobile"
        return
    fi
    local t_lines
    t_lines=$(get_current_lines)
    if [ "$t_lines" -ge 28 ]; then
        echo "tall"
    elif [ "$t_lines" -ge 20 ]; then
        echo "medium"
    elif [ "$t_lines" -ge 13 ]; then
        echo "compact"
    else
        echo "tiny"
    fi
}

draw_banner() {
    if [ "$1" != "--no-clear" ]; then
        clear
    fi
    local tier
    tier=$(get_layout_tier)
    local term_cols
    term_cols=$(get_current_cols)

    case "$tier" in
        mobile)
            echo -e "${C_LIGHT_G}${C_BOLD}"
            cat << "EOF"
  ___ _  _  ___  ___ _____
 / __| || |/ _ \/ __|_   _|
| (_ | __ | (_) \__ \ | |  
 \___|_||_|\___/|___/ |_|  
EOF
            echo -e "${C_RESET}  ${C_WHITE}${C_BOLD}[+] G H O S T - S T A C K [+]${C_RESET}"
            echo -e "   ${C_GRAY}By Mwenda Boniface (Termux Mobile)${C_RESET}"
            ;;
        tall)
            echo -e "${C_LIGHT_G}${C_BOLD}"
            if [ "$term_cols" -ge 65 ]; then
                cat << "EOF"
   ________               __       _____ __             __  
  / ____/ /_  ____  _____/ /_     / ___// /_____ ______/ /__
 / / __/ __ \/ __ \/ ___/ __/_____\__ \/ __/ __ `/ ___/ //_/
/ /_/ / / / / /_/ (__  ) /_/_____/__/ / /_/ /_/ / /__/ ,<   
\____/_/ /_/\____/____/\__/     /____/\__/\__,_/\___/_/|_|  
EOF
                echo -e "${C_RESET}"
                if [ "$term_cols" -ge 96 ]; then
                    echo -e "       ${C_WHITE}${C_BOLD}[ + ]   C O D E   B Y   M W E N D A   B O N I F A C E   [ + ]${C_RESET}"
                else
                    echo -e "     ${C_WHITE}${C_BOLD}[+] CODE BY MWENDA BONIFACE [+]${C_RESET}"
                fi
            else
                cat << "EOF"
  ____ _  _  ___  ___ _____   ___ _____ _   ___ _  _ 
 / ___| || |/ _ \/ __|_   _| / __|_   _/_\ / __| |/ /
| (_ || __ | (_) \__ \ | |   \__ \ | |/ _ \ (__| ' < 
 \____|_||_|\___/|___/ |_|   |___/ |_/_/ \_\___|_|\_\
EOF
                local pc_os_badge="DESKTOP LINUX"
                if echo "$OS_NAME" | grep -qi "kali"; then pc_os_badge="KALI LINUX"; fi
                echo -e "${C_RESET}  ${C_WHITE}${C_BOLD}[+] GHOST-STACK // ${pc_os_badge} [+]${C_RESET}"
            fi
            ;;
        medium)
            local pc_os_badge="DESKTOP LINUX"
            if echo "$OS_NAME" | grep -qi "kali"; then pc_os_badge="KALI LINUX"; fi
            echo -e "  ${C_LIGHT_G}${C_BOLD}[ + ] GHOST-STACK // ${pc_os_badge} (${ARCH}) [ + ]${C_RESET}"
            echo -e "  ${C_GRAY}System & Toolchain Orchestrator by Mwenda Boniface${C_RESET}"
            ;;
        compact)
            local pc_os_badge="DESKTOP LINUX"
            if echo "$OS_NAME" | grep -qi "kali"; then pc_os_badge="KALI LINUX"; fi
            echo -e "  ${C_LIGHT_G}${C_BOLD}[+] GHOST-STACK // ${pc_os_badge} (${ARCH}) [+]${C_RESET}"
            ;;
        tiny)
            # Handled inline in telemetry
            ;;
    esac
}

get_cpu_speed() {
    local speed=""
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ] || [ -d /sys/devices/system/cpu/cpufreq ]; then
        local khz
        khz=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null | sort -nr 2>/dev/null | head -n 1)
        [ -z "$khz" ] && khz=$(cat /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq 2>/dev/null | sort -nr 2>/dev/null | head -n 1)
        [ -z "$khz" ] && khz=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
        if [ -n "$khz" ] && [ "$khz" -gt 0 ] 2>/dev/null; then
            speed=$(awk -v k="$khz" 'BEGIN {printf "%.2f GHz", k/1000000}')
        fi
    fi
    if [ -z "$speed" ] && [ -f /proc/cpuinfo ]; then
        local mhz
        mhz=$(awk -F: '/cpu MHz/{print $2}' /proc/cpuinfo 2>/dev/null | sort -nr 2>/dev/null | head -n 1 | xargs)
        if [ -n "$mhz" ]; then
            speed=$(awk -v m="$mhz" 'BEGIN {printf "%.2f GHz", m/1000}')
        fi
    fi
    if [ -z "$speed" ] && command -v lscpu >/dev/null 2>&1; then
        local max_mhz
        max_mhz=$(lscpu 2>/dev/null | awk -F: '/CPU max MHz/{print $2}' | xargs)
        if [ -n "$max_mhz" ]; then
            speed=$(awk -v m="$max_mhz" 'BEGIN {printf "%.2f GHz", m/1000}')
        fi
    fi
    if [ -z "$speed" ] && [ -f /proc/cpuinfo ]; then
        speed=$(grep -m 1 "model name" /proc/cpuinfo 2>/dev/null | sed -n 's/.*@ *\([0-9.]*[A-Za-z]*Hz\).*/\1/p')
    fi
    [ -z "$speed" ] && speed="N/A"
    echo "$speed"
}

get_mem_info() {
    if command -v free >/dev/null 2>&1; then
        free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2 " (" $7 " Free)"}'
    elif [ -f /proc/meminfo ]; then
        awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END {printf "%.1fG / %.1fG (%.1fG Free)\n", (t-a)/1024/1024, t/1024/1024, a/1024/1024}' /proc/meminfo 2>/dev/null
    else
        echo "N/A"
    fi
}

get_disk_info() {
    local dinfo
    dinfo=$(df -h "$ROOT_DIR" 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $4 " Free)"}')
    if [ -z "$dinfo" ]; then
        dinfo=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $4 " Free)"}')
    fi
    [ -z "$dinfo" ] && dinfo="N/A"
    echo "$dinfo"
}

draw_telemetry_col() {
    local label="$1"
    local val="$2"
    local width="$3"
    local padded_label
    printf -v padded_label "%-16s" "$label"
    local max_val_len=$(( width - 22 ))
    if [ "${#val}" -gt "$max_val_len" ]; then
        val="...${val: -$((max_val_len - 3))}"
    fi
    local visible_len=$(( 4 + 16 + 2 + ${#val} ))
    local pad=0
    if [ "$visible_len" -lt "$width" ]; then
        pad=$((width - visible_len))
    fi
    printf "${C_MINT}[*] %s:${C_RESET} ${C_WHITE}%s${C_RESET}%*s" "$padded_label" "$val" "$pad" ""
}

draw_telemetry_row() {
    local l_lbl="$1" l_val="$2" r_lbl="$3" r_val="$4"
    echo -en "  ${C_GRAY}│${C_RESET}   "
    draw_telemetry_col "$l_lbl" "$l_val" 48
    echo -en "  "
    draw_telemetry_col "$r_lbl" "$r_val" 48
    echo -e "   ${C_GRAY}│${C_RESET}"
}

draw_home_telemetry() {
    local platform_label
    if [ "$IS_TERMUX" = true ]; then
        platform_label="Android (Termux PKG)"
    else
        platform_label="Native Linux (APT)"
    fi

    local cpu_speed mem_info disk_info display_workspace term_cols term_lines tier
    cpu_speed=$(get_cpu_speed)
    mem_info=$(get_mem_info)
    disk_info=$(get_disk_info)
    display_workspace=$(echo "$ROOT_DIR" | sed "s|^$HOME|~|")
    term_cols=$(get_current_cols)
    term_lines=$(get_current_lines)
    tier=$(get_layout_tier)
    G_LAYOUT_TIER="$tier"

    # Resolve detected OS name (compact string for small boxes)
    local os_compact="$OS_NAME"
    if [ "$IS_TERMUX" = true ]; then
        os_compact="Termux"
    else
        if echo "$OS_NAME" | grep -qi "kali"; then
            os_compact="Kali Linux"
        elif echo "$OS_NAME" | grep -qi "ubuntu"; then
            os_compact="Ubuntu Linux"
        elif echo "$OS_NAME" | grep -qi "debian"; then
            os_compact="Debian Linux"
        else
            os_compact=$(echo "$OS_NAME" | awk '{print $1}')
        fi
    fi

    case "$tier" in
        mobile)
            local m_arch="$ARCH"
            local m_cpu="$cpu_speed"
            local m_os="Termux"
            local m_user="$CURRENT_USER"
            local m_ram
            m_ram=$(echo "$mem_info" | awk '{print $1 "/" $3}' | sed 's/Gi/G/g; s/Mi/M/g')
            [ -z "$m_ram" ] && m_ram="2.4G/3.7G"
            local m_disk
            m_disk=$(echo "$disk_info" | awk '{print $1 "/" $3}' | sed 's/Gi/G/g; s/Mi/M/g')
            [ -z "$m_disk" ] && m_disk="43G/113G"

            echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM TELEMETRY${C_RESET} ${C_GRAY}]──────────────┐${C_RESET}"
            printf "  ${C_GRAY}│${C_RESET} ${C_MINT}%-4s:${C_RESET} ${C_WHITE}%-9.9s${C_RESET}   ${C_MINT}%-4s:${C_RESET} ${C_WHITE}%-8.8s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "Arch" "$m_arch" "CPU" "$m_cpu"
            printf "  ${C_GRAY}│${C_RESET} ${C_MINT}%-4s:${C_RESET} ${C_WHITE}%-9.9s${C_RESET}   ${C_MINT}%-4s:${C_RESET} ${C_WHITE}%-8.8s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "OS" "$m_os" "User" "$m_user"
            printf "  ${C_GRAY}│${C_RESET} ${C_MINT}%-4s:${C_RESET} ${C_WHITE}%-9.9s${C_RESET}   ${C_MINT}%-4s:${C_RESET} ${C_WHITE}%-8.8s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "RAM" "$m_ram" "Disk" "$m_disk"
            echo -e "  ${C_GRAY}└───────────────────────────────────┘${C_RESET}"

            G_CPU_ROW=8
            G_CPU_COL=29
            G_RAM_ROW=10
            G_RAM_COL=10
            ;;

        tall)
            if [ "$term_cols" -ge 96 ]; then
                echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM ENVIRONMENT TELEMETRY${C_RESET} ${C_GRAY}]$(printf "%0.s─" {1..71})┐${C_RESET}"
                draw_telemetry_row "Architecture" "$ARCH" "CPU Speed" "$cpu_speed"
                draw_telemetry_row "Operating System" "$OS_NAME" "Active Session" "$CURRENT_USER"
                draw_telemetry_row "Memory (RAM)" "$mem_info" "Disk Storage" "$disk_info"
                draw_telemetry_row "Runtime Platform" "$platform_label" "Workspace Path" "$display_workspace"
                echo -e "  ${C_GRAY}└$(printf "%0.s─" {1..104})┘${C_RESET}"

                G_CPU_ROW=8
                G_CPU_COL=79
                G_RAM_ROW=10
                G_RAM_COL=29
            elif [ "$term_cols" -ge 60 ]; then
                local s_arch="$ARCH"
                local s_cpu="$cpu_speed"
                local s_os="$os_compact"
                local s_user="$CURRENT_USER"
                local s_ram
                s_ram=$(echo "$mem_info" | awk '{print $1 "/" $3}')
                [ -z "$s_ram" ] && s_ram="4.8G/7.6G"
                local s_disk
                s_disk=$(echo "$disk_info" | awk '{print $1 "/" $3}')
                [ -z "$s_disk" ] && s_disk="57G/226G"
                local s_mode="Native APT"
                local s_path
                s_path=$(basename "$ROOT_DIR")
                [ -z "$s_path" ] && s_path="setup-wizard"

                echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM TELEMETRY${C_RESET} ${C_GRAY}]────────────────────────────────────┐${C_RESET}"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] Arch :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_MINT}[*] CPU  :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_GRAY}│${C_RESET}\n" "$s_arch" "$s_cpu"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] OS   :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_MINT}[*] User :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_GRAY}│${C_RESET}\n" "$s_os" "$s_user"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] RAM  :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_MINT}[*] Disk :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_GRAY}│${C_RESET}\n" "$s_ram" "$s_disk"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] Mode :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_MINT}[*] Path :${C_RESET} ${C_WHITE}%-14s${C_RESET} ${C_GRAY}│${C_RESET}\n" "$s_mode" "$s_path"
                echo -e "  ${C_GRAY}└────────────────────────────────────────────────────────┘${C_RESET}"

                G_CPU_ROW=8
                G_CPU_COL=43
                G_RAM_ROW=10
                G_RAM_COL=17
            else
                local p_arch="$ARCH"
                local p_cpu="$cpu_speed"
                local p_os="$os_compact"
                local p_user="$CURRENT_USER"
                local p_ram
                p_ram=$(echo "$mem_info" | awk '{print $1 "/" $3}')
                [ -z "$p_ram" ] && p_ram="4.8G/7.6G"
                local p_disk
                p_disk=$(echo "$disk_info" | awk '{print $1 "/" $3}')
                [ -z "$p_disk" ] && p_disk="57G/226G"

                echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}PC TELEMETRY // ${p_os^^}${C_RESET} ${C_GRAY}]─────────────────┐${C_RESET}"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}OS   :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_MINT}Arch :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "$p_os" "$p_arch"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}User :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_MINT}CPU  :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "$p_user" "$p_cpu"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}RAM  :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_MINT}Disk :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "$p_ram" "$p_disk"
                echo -e "  ${C_GRAY}└──────────────────────────────────────────────────┘${C_RESET}"

                G_CPU_ROW=8
                G_CPU_COL=36
                G_RAM_ROW=9
                G_RAM_COL=12
            fi
            ;;

        medium)
            local m_ram
            m_ram=$(echo "$mem_info" | awk '{print $1 "/" $3}')
            [ -z "$m_ram" ] && m_ram="4.8G/7.6G"
            local m_disk
            m_disk=$(echo "$disk_info" | awk '{print $1 "/" $3}')
            [ -z "$m_disk" ] && m_disk="57G/226G"

            if [ "$term_cols" -ge 80 ]; then
                echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM ENVIRONMENT TELEMETRY${C_RESET} ${C_GRAY}]────────────────────────────────────────┐${C_RESET}"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] Arch:${C_RESET} ${C_WHITE}%-8s${C_RESET}   ${C_MINT}[*] CPU :${C_RESET} ${C_WHITE}%-11s${C_RESET}   ${C_MINT}[*] RAM :${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "$ARCH" "$cpu_speed" "$m_ram"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] OS  :${C_RESET} ${C_WHITE}%-8s${C_RESET}   ${C_MINT}[*] User:${C_RESET} ${C_WHITE}%-11s${C_RESET}   ${C_MINT}[*] Disk:${C_RESET} ${C_WHITE}%-14s${C_RESET}  ${C_GRAY}│${C_RESET}\n" "$os_compact" "$CURRENT_USER" "$m_disk"
                echo -e "  ${C_GRAY}└─────────────────────────────────────────────────────────────────────────────┘${C_RESET}"

                G_CPU_ROW=4
                G_CPU_COL=37
                G_RAM_ROW=4
                G_RAM_COL=62
            else
                echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM TELEMETRY${C_RESET} ${C_GRAY}]────────────────────────────────────┐${C_RESET}"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] Arch:${C_RESET} ${C_WHITE}%-12s${C_RESET}  ${C_MINT}[*] CPU :${C_RESET} ${C_WHITE}%-11s${C_RESET}   ${C_GRAY}│${C_RESET}\n" "$ARCH" "$cpu_speed"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] OS  :${C_RESET} ${C_WHITE}%-12s${C_RESET}  ${C_MINT}[*] User:${C_RESET} ${C_WHITE}%-11s${C_RESET}   ${C_GRAY}│${C_RESET}\n" "$os_compact" "$CURRENT_USER"
                printf "  ${C_GRAY}│${C_RESET}  ${C_MINT}[*] RAM :${C_RESET} ${C_WHITE}%-12s${C_RESET}  ${C_MINT}[*] Disk:${C_RESET} ${C_WHITE}%-11s${C_RESET}   ${C_GRAY}│${C_RESET}\n" "$m_ram" "$m_disk"
                echo -e "  ${C_GRAY}└────────────────────────────────────────────────────────┘${C_RESET}"

                G_CPU_ROW=4
                G_CPU_COL=38
                G_RAM_ROW=6
                G_RAM_COL=15
            fi
            ;;

        compact)
            local c_ram
            c_ram=$(echo "$mem_info" | awk '{print $1 "/" $3}')
            [ -z "$c_ram" ] && c_ram="4.8G/7.6G"
            local c_disk
            c_disk=$(echo "$disk_info" | awk '{print $1 "/" $3}')
            [ -z "$c_disk" ] && c_disk="57G/226G"

            echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}TELEMETRY${C_RESET} ${C_GRAY}]─────────────────────────────────────────────────────────┐${C_RESET}"
            printf "  ${C_GRAY}│${C_RESET} ${C_MINT}CPU:${C_RESET} ${C_WHITE}%-10s${C_RESET} │ ${C_MINT}RAM:${C_RESET} ${C_WHITE}%-11s${C_RESET} │ ${C_MINT}Disk:${C_RESET} ${C_WHITE}%-9s${C_RESET} │ ${C_MINT}OS:${C_RESET} ${C_WHITE}%-11s${C_RESET} ${C_GRAY}│${C_RESET}\n" "$cpu_speed" "$c_ram" "$c_disk" "$os_compact"
            echo -e "  ${C_GRAY}└────────────────────────────────────────────────────────────────────────┘${C_RESET}"

            G_CPU_ROW=3
            G_CPU_COL=10
            G_RAM_ROW=3
            G_RAM_COL=28
            ;;

        tiny)
            local t_ram
            t_ram=$(echo "$mem_info" | awk '{print $1 "/" $3}')
            [ -z "$t_ram" ] && t_ram="4.8G/7.6G"

            printf "  ${C_LIGHT_G}${C_BOLD}[+] GHOST-STACK${C_RESET} │ ${C_MINT}CPU:${C_RESET} ${C_WHITE}%-9s${C_RESET} │ ${C_MINT}RAM:${C_RESET} ${C_WHITE}%-10s${C_RESET} │ ${C_WHITE}%s${C_RESET}\n" "$cpu_speed" "$t_ram" "$os_compact"
            G_CPU_ROW=1
            G_CPU_COL=25
            G_RAM_ROW=1
            G_RAM_COL=43
            ;;
    esac
}

pause() {
    echo ""
    echo -e "${C_GRAY}Press [Enter] to continue...${C_RESET}"
    read -r || true
}

