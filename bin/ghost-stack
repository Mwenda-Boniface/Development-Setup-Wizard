get_category_array_name() {
    case "$1" in
        android|1) echo "TOOLS_ANDROID" ;;
        ios|2)     echo "TOOLS_IOS" ;;
        web|3)     echo "TOOLS_WEB" ;;
        ai|4)      echo "TOOLS_AI" ;;
        software|tools|5) echo "TOOLS_SOFTWARE" ;;
        core|git|devops|6) echo "TOOLS_CORE" ;;
        *) return 1 ;;
    esac
}

get_category_title() {
    case "$1" in
        android|1) echo "ANDROID DEVELOPMENT" ;;
        ios|2)     echo "IOS DEVELOPMENT (LINUX TOOLS)" ;;
        web|3)     echo "WEB DEVELOPMENT" ;;
        ai|4)      echo "AI & MACHINE LEARNING DEVELOPMENT" ;;
        software|tools|5) echo "DEVELOPMENT SOFTWARES & IDES" ;;
        core|git|devops|6) echo "CORE SYSTEM TOOLS & DEVOPS" ;;
        *) echo "UNKNOWN CATEGORY" ;;
    esac
}

# ==============================================================================
# CLI EXECUTION MODES
# ==============================================================================
cli_scan() {
    local target_cat="$1"

    if [ -n "$target_cat" ]; then
        local arr_name
        arr_name=$(get_category_array_name "$target_cat") || {
            echo -e "${C_RED}Error: Unknown category '$target_cat'.${C_RESET}"
            echo "Available categories: android, ios, web, ai, tools, core"
            exit 1
        }
        local title
        title=$(get_category_title "$target_cat")
        echo -e "${C_DARK_G}┌─[ ${C_LIGHT_G}${C_BOLD}DIAGNOSTIC SCAN: $title${C_RESET}${C_DARK_G} ]${C_RESET}"
        eval "local tools=(\"\${${arr_name}[@]}\")"
        local missing=0
        for item in "${tools[@]}"; do
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            if $check_fn; then
                badge_ok "$name"
            else
                badge_missing "$name"
                ((missing++))
            fi
        done
        echo -e "${C_DARK_G}└─────────────────────────────────────────────────────────${C_RESET}"
        [ "$missing" -eq 0 ] && exit 0 || exit 1
    fi

    draw_banner
    echo -e "  ${C_WHITE}${C_BOLD}COMPREHENSIVE TOOLCHAIN DIAGNOSTIC SCAN${C_RESET}\n"

    local categories=("TOOLS_ANDROID" "TOOLS_IOS" "TOOLS_WEB" "TOOLS_AI" "TOOLS_SOFTWARE" "TOOLS_CORE")
    local titles=("ANDROID DEVELOPMENT" "IOS DEVELOPMENT (LINUX TOOLS)" "WEB DEVELOPMENT" "AI & MACHINE LEARNING" "DEVELOPMENT SOFTWARES" "CORE SYSTEM TOOLS & DEVOPS")

    local total_checked=0
    local total_passed=0

    for idx in "${!categories[@]}"; do
        echo -e "${C_DARK_G}┌─[ ${C_LIGHT_G}${C_BOLD}${titles[$idx]}${C_RESET}${C_DARK_G} ]${C_RESET}"
        eval "local tools=(\"\${${categories[$idx]}[@]}\")"
        for item in "${tools[@]}"; do
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            ((total_checked++))
            if $check_fn; then
                badge_ok "$name"
                ((total_passed++))
            else
                badge_missing "$name"
            fi
        done
        echo -e "${C_DARK_G}└─────────────────────────────────────────────────────────${C_RESET}\n"
    done

    echo -e "  ${C_WHITE}${C_BOLD}Scan Summary:${C_RESET} ${C_LIGHT_G}$total_passed${C_RESET} of ${C_WHITE}$total_checked${C_RESET} tools verified."
    if [ "$total_passed" -eq "$total_checked" ]; then
        echo -e "  ${C_LIGHT_G}${C_BOLD}Status: All required developer tools are verified!${C_RESET}\n"
        exit 0
    else
        echo -e "  ${C_YELLOW}${C_BOLD}Status: Missing tools detected.${C_RESET}\n"
        exit 1
    fi
}

cli_install() {
    local cat_input="$1"
    local tools_input="$2"

    if [ -z "$cat_input" ]; then
        echo -e "${C_RED}Error: Category required. Example: ghost-stack install web 1,3 or ghost-stack install ai all${C_RESET}"
        exit 1
    fi

    local arr_name
    arr_name=$(get_category_array_name "$cat_input") || {
        echo -e "${C_RED}Error: Unknown category '$cat_input'.${C_RESET}"
        echo "Valid categories: android, ios, web, ai, tools, core"
        exit 1
    }

    eval "local tools=(\"\${${arr_name}[@]}\")"
    local uninstalled_names=()
    local uninstalled_installers=()
    local uninstalled_checkers=()

    for item in "${tools[@]}"; do
        local name="${item%%|*}"
        local rest="${item#*|}"
        local check_fn="${rest%%|*}"
        local install_fn="${rest#*|}"
        if ! $check_fn; then
            uninstalled_names+=("$name")
            uninstalled_installers+=("$install_fn")
            uninstalled_checkers+=("$check_fn")
        fi
    done

    if [ ${#uninstalled_names[@]} -eq 0 ]; then
        echo -e "${C_LIGHT_G}[OK] All tools in category '$cat_input' are already installed.${C_RESET}"
        exit 0
    fi

    if [ -z "$tools_input" ]; then
        echo -e "${C_YELLOW}Missing tools in category '$cat_input':${C_RESET}"
        for i in "${!uninstalled_names[@]}"; do
            echo -e "  [ $((i+1)) ] ${uninstalled_names[$i]}"
        done
        echo ""
        echo "Run with selection, e.g.: ghost-stack install $cat_input 1,2 or ghost-stack install $cat_input all"
        exit 0
    fi

    local target_indices=()
    if [ "$tools_input" = "all" ] || [ "$tools_input" = "ALL" ]; then
        for i in "${!uninstalled_installers[@]}"; do
            target_indices+=("$i")
        done
    else
        IFS=',' read -ra SELECTED <<< "$tools_input"
        for sel in "${SELECTED[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#uninstalled_names[@]}" ]; then
                target_indices+=("$((sel - 1))")
            else
                echo -e "${C_RED}Skipping invalid selection index: $sel${C_RESET}"
            fi
        done
    fi

    local verified_count=0
    local failed_count=0

    for idx in "${target_indices[@]}"; do
        local t_name="${uninstalled_names[$idx]}"
        local t_installer="${uninstalled_installers[$idx]}"
        local t_checker="${uninstalled_checkers[$idx]}"

        echo -e "\n${C_DARK_G}>>> [ $((idx+1)) ] Provisioning: ${C_WHITE}${t_name}${C_RESET}"
        $t_installer
        sync_env

        if $t_checker; then
            echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ] Verified:${C_RESET} ${C_WHITE}${t_name}${C_RESET} is active and verified."
            ((verified_count++))
        else
            echo -e "  ${C_RED}${C_BOLD}[ FAILED ] Check Failed:${C_RESET} ${C_YELLOW}${t_name}${C_RESET} was not verified after setup."
            ((failed_count++))
        fi
    done

    sync_env
    persist_env
    auto_stamp_desktop

    echo ""
    echo -e "  ${C_GRAY}─────────────────────────────────────────────────────────────────${C_RESET}"
    if [ "$failed_count" -eq 0 ] && [ "$verified_count" -gt 0 ]; then
        echo -e "  ${C_LIGHT_G}${C_BOLD}[ SUCCESS ] All $verified_count selected tools verified successfully!${C_RESET}\n"
    elif [ "$failed_count" -gt 0 ]; then
        echo -e "  ${C_YELLOW}${C_BOLD}[ ATTENTION ] Completed with issues: $verified_count verified, $failed_count failed verification.${C_RESET}\n"
    fi
}

cli_install_binary() {
    local bin_target="$CURRENT_HOME/.local/bin"
    if [ "$IS_TERMUX" = true ] && [ -n "$PREFIX" ] && [ -d "$PREFIX/bin" ]; then
        bin_target="$PREFIX/bin"
    else
        mkdir -p "$bin_target" "$CURRENT_HOME/.local/share/applications" "$CURRENT_HOME/Desktop"
    fi
    ln -sf "$REAL_SCRIPT_PATH" "$bin_target/ghost-stack"
    chmod +x "$bin_target/ghost-stack" 2>/dev/null || true
    rm -f "$bin_target/dev-wizard" 2>/dev/null || true
    
    if [ "$IS_TERMUX" = false ] && [ -f "$ROOT_DIR/Ghost-Stack.desktop" ]; then
        cp "$ROOT_DIR/Ghost-Stack.desktop" "$CURRENT_HOME/Desktop/Ghost-Stack.desktop" 2>/dev/null || true
        cp "$ROOT_DIR/Ghost-Stack.desktop" "$CURRENT_HOME/.local/share/applications/ghost-stack.desktop" 2>/dev/null || true
        rm -f "$CURRENT_HOME/Desktop/Dev-Setup-Wizard.desktop" "$CURRENT_HOME/.local/share/applications/dev-setup-wizard.desktop" 2>/dev/null || true
        auto_stamp_desktop
    fi
    
    persist_env
    echo -e "${C_LIGHT_G}${C_BOLD}[OK] 'ghost-stack' has been installed to $bin_target/ghost-stack${C_RESET}"
    echo -e "You can now run ${C_WHITE}${C_BOLD}ghost-stack${C_RESET} directly from any terminal directory!"
}

cli_doctor() {
    sync_env
    draw_banner
    echo -e "  ${C_WHITE}${C_BOLD}FLUTTER & ANDROID TOOLCHAIN DOCTOR${C_RESET}\n"
    if command -v flutter >/dev/null 2>&1; then
        flutter doctor -v
    elif [ -x "$FLUTTER_DIR/bin/flutter" ]; then
        "$FLUTTER_DIR/bin/flutter" doctor -v
    else
        echo -e "${C_RED}Flutter binary not found. Install it via 'ghost-stack install android 9'.${C_RESET}"
        exit 1
    fi
}

# ==============================================================================
# STYLED & COLORED HELP RENDERERS (WITH EXIT & BACK NAVIGATION)
# ==============================================================================
# Return Codes: 0 = Back to Help Menu, 10 = Jump to Main Menu, 20 = Exit App
render_help_viewer() {
    local title="$1"
    shift
    local lines=("$@")

    while true; do
        clear
        draw_banner
        echo -e "${C_DARK_G}┌─[ ${C_WHITE}${title}${C_RESET} ${C_DARK_G}]───────────────────────────────────┐${C_RESET}"
        echo -e "${C_DARK_G}│${C_RESET}"
        for line in "${lines[@]}"; do
            echo -e "${C_DARK_G}│${C_RESET}  $line"
        done
        echo -e "${C_DARK_G}│${C_RESET}"
        echo -e "${C_DARK_G}└───────────────────────────────────────────────────────────────────────────────┘${C_RESET}"
        echo ""
        echo -e "  ${C_WHITE}${C_BOLD}Navigation Options:${C_RESET}"
        echo -e "  ${C_WHITE}[ B ]${C_RESET} ${C_LIGHT_G}Return to Help Menu${C_RESET}   ${C_WHITE}[ M ]${C_RESET} ${C_LIGHT_G}Jump to Main Menu${C_RESET}   ${C_WHITE}[ 0 / Q ]${C_RESET} ${C_GRAY}Exit Ghost-Stack${C_RESET}"
        echo ""
        echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(help) > ${C_RESET}"
        read -r nav_choice || return 0

        case "$nav_choice" in
            [bB]|back|BACK|prev|PREV|"") return 0 ;;
            [mM]|main|MAIN|menu|MENU) return 10 ;;
            0|[qQ]|exit|EXIT|quit|QUIT) return 20 ;;
            *) sleep 0.3 ;;
        esac
    done
}

