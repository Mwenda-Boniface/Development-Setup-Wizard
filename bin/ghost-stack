check_lazygit() { command -v lazygit >/dev/null 2>&1; }
install_lazygit() {
    echo -e "${C_MINT}Installing Lazygit (Terminal UI for Git)...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install lazygit
    else
        local lg_ver
        lg_ver=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        if [ -n "$lg_ver" ]; then
            curl -Lo "$TMP_DIR/lazygit.tar.gz" "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${lg_ver}_Linux_x86_64.tar.gz"
            sudo tar -xf "$TMP_DIR/lazygit.tar.gz" -C /usr/local/bin lazygit
            rm -f "$TMP_DIR/lazygit.tar.gz"
        else
            pkg_install lazygit || true
        fi
    fi
}

