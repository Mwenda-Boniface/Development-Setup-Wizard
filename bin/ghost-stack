ensure_pip() {
    if ! command -v pip3 >/dev/null 2>&1 && ! python3 -m pip --version >/dev/null 2>&1; then
        echo -e "${C_YELLOW}Bootstrapping pip and Python virtual environment tools...${C_RESET}"
        install_python_env
    fi
}

