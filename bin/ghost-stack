# --- [01. ANDROID DEVELOPMENT] ---
check_java21() {
    if [ "$IS_TERMUX" = true ]; then
        command -v java >/dev/null 2>&1
    else
        [ -d "$JAVA_21_PATH" ] || (command -v java >/dev/null && java -version 2>&1 | grep -q "21\.")
    fi
}
install_java21() {
    echo -e "${C_MINT}Installing OpenJDK...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install openjdk-17
    else
        pkg_install openjdk-21-jdk
    fi
    sync_env
}

check_java17() {
    [ -d "$JAVA_17_PATH" ] || (command -v java >/dev/null && java -version 2>&1 | grep -q "17\.")
}
install_java17() {
    echo -e "${C_MINT}Installing OpenJDK 17 LTS (Gradle fallback)...${C_RESET}"
    pkg_install openjdk-17-jdk
    sync_env
}

check_android_cmdline() { [ -x "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" ]; }
install_android_cmdline() {
    check_java21 || check_java17 || install_java21
    echo -e "${C_MINT}Downloading Android Command-Line Tools (sdkmanager)...${C_RESET}"
    mkdir -p "$ANDROID_DIR/cmdline-tools" "$TMP_DIR"
    local zip_file="$TMP_DIR/cmdline-tools.zip"
    curl -L -o "$zip_file" "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
    unzip -q -o "$zip_file" -d "$TMP_DIR/cmdline-extract"
    mkdir -p "$ANDROID_DIR/cmdline-tools/latest"
    cp -r "$TMP_DIR"/cmdline-extract/cmdline-tools/* "$ANDROID_DIR/cmdline-tools/latest/"
    chmod +x "$ANDROID_DIR/cmdline-tools/latest/bin/"* 2>/dev/null || true
    rm -rf "$TMP_DIR/cmdline-extract" "$zip_file"
    sync_env
}

check_android_platform_tools() { [ -x "$ANDROID_DIR/platform-tools/adb" ] || command -v adb >/dev/null 2>&1; }
install_android_platform_tools() {
    echo -e "${C_MINT}Installing Android Platform-Tools (adb, fastboot)...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install android-tools
    else
        check_android_cmdline || install_android_cmdline
        sync_env
        echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "platform-tools"
    fi
}

check_android_platforms() { [ -d "$ANDROID_DIR/platforms/android-36" ] || [ -d "$ANDROID_DIR/platforms/android-34" ]; }
install_android_platforms() {
    echo -e "${C_MINT}Installing Android SDK Platforms (API 34 & 36)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "platforms;android-36" "platforms;android-34"
}

check_android_build_tools() { [ -d "$ANDROID_DIR/build-tools/28.0.3" ] || [ -d "$ANDROID_DIR/build-tools/34.0.0" ]; }
install_android_build_tools() {
    echo -e "${C_MINT}Installing Android Build-Tools (28.0.3 & 34.0.0)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "build-tools;28.0.3" "build-tools;34.0.0"
}

check_android_ndk() { [ -d "$ANDROID_DIR/ndk" ] && [ "$(ls -A "$ANDROID_DIR/ndk" 2>/dev/null)" ]; }
install_android_ndk() {
    echo -e "${C_MINT}Installing Android NDK (Native Development Kit)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "ndk;26.2.11394342" || echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "ndk-bundle"
}

check_gradle() { command -v gradle >/dev/null 2>&1; }
install_gradle() {
    echo -e "${C_MINT}Installing Gradle Build Tool...${C_RESET}"
    pkg_install gradle
}

check_flutter() { [ -x "$FLUTTER_DIR/bin/flutter" ] || command -v flutter >/dev/null 2>&1; }
install_flutter() {
    echo -e "${C_MINT}Cloning Flutter SDK (stable channel)...${C_RESET}"
    mkdir -p "$DEV_DIR"
    if [ ! -d "$FLUTTER_DIR" ]; then
        git clone https://github.com/flutter/flutter.git -b stable "$FLUTTER_DIR"
    else
        cd "$FLUTTER_DIR" && git pull || true
    fi
    sync_env
    "$FLUTTER_DIR/bin/flutter" precache
    "$FLUTTER_DIR/bin/flutter" config --android-sdk "$ANDROID_DIR" || true
    yes | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" --licenses 2>/dev/null || true
}

check_scrcpy() { command -v scrcpy >/dev/null 2>&1; }
install_scrcpy() {
    echo -e "${C_MINT}Installing Scrcpy (Android Screen Mirroring over USB)...${C_RESET}"
    pkg_install scrcpy
}

