    echo ""
    echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack > ${C_RESET}${choice}\033[K"
    printf "\033[?25h"
}

update_telemetry_in_place() {
    local new_cpu="$1"
    local new_ram="$2"
    if [ -n "$G_CPU_ROW" ] && [ "$G_CPU_ROW" -gt 0 ]; then
        # Hide cursor and save cursor position (DEC + ANSI)
        printf "\033[?25l\0337\033[s"

        # Update CPU Speed
        printf "\033[%d;%dH" "$G_CPU_ROW" "$G_CPU_COL"
        local cpu_fmt="%-11s"
        if [ "$G_LAYOUT_TIER" = "tall" ]; then cpu_fmt="%-14s"; fi
        printf "${C_WHITE}${cpu_fmt}${C_RESET}" "$new_cpu"

        # Update RAM
        if [ -n "$G_RAM_ROW" ] && [ "$G_RAM_ROW" -gt 0 ]; then
            printf "\033[%d;%dH" "$G_RAM_ROW" "$G_RAM_COL"
            local ram_fmt="%-12s"
            if [ "$G_LAYOUT_TIER" = "tall" ]; then ram_fmt="%-22s"; fi
            if [ "$G_LAYOUT_TIER" = "mobile" ]; then ram_fmt="%-8.8s"; fi
            local ram_display="$new_ram"
            if [ "$G_LAYOUT_TIER" = "medium" ] || [ "$G_LAYOUT_TIER" = "compact" ] || [ "$G_LAYOUT_TIER" = "tiny" ]; then
                ram_display=$(echo "$new_ram" | awk '{print $1 "/" $3}')
                [ -z "$ram_display" ] && ram_display="4.8G/7.6G"
            fi
            printf "${C_WHITE}${ram_fmt}${C_RESET}" "$ram_display"
        fi

        # Restore cursor position and visibility
        printf "\0338\033[u\033[?25h"
    fi
}

tui_main() {
    local need_clear=true
    local choice=""
    local last_cpu=""
    local last_ram=""

    while true; do
        if [ "$need_clear" = true ] || [ "$G_WINCH_EVENT" = true ]; then
            render_home_dashboard "$choice"
            need_clear=false
            G_WINCH_EVENT=false
            last_cpu=$(get_cpu_speed)
            last_ram=$(get_mem_info)
        fi

        local key=""
        if IFS= read -rs -n 1 -t 1 key; then
            if [[ $key == $'\0' || $key == $'\n' ]]; then
                local selected="$choice"
                choice=""
                if [ -z "$selected" ]; then
                    continue
                fi
                need_clear=true
                case "$selected" in
                    [rR]) continue ;;
                    1|01) handle_tui_category "ANDROID DEVELOPMENT" "TOOLS_ANDROID" "android" ;;
                    2|02) handle_tui_category "IOS DEVELOPMENT (LINUX STACK)" "TOOLS_IOS" "ios" ;;
                    3|03) handle_tui_category "WEB DEVELOPMENT" "TOOLS_WEB" "web" ;;
                    4|04) handle_tui_category "AI & MACHINE LEARNING" "TOOLS_AI" "ai" ;;
                    5|05) handle_tui_category "DEVELOPMENT SOFTWARES & IDES" "TOOLS_SOFTWARE" "tools" ;;
                    6|06) handle_tui_category "CORE SYSTEM TOOLS & DEVOPS" "TOOLS_CORE" "core" ;;
                    7|07|[cC]|clean|cleaner) run_system_cleaner; continue ;;
                    8|08|desktop|app) run_create_desktop_app; continue ;;
                    [sS]) cli_scan ""; pause ;;
                    [dD]) cli_doctor; pause ;;
                    [hH]) handle_help_menu ;;
                    0|00|[qQ])
                        echo -e "\n${C_LIGHT_G}Exiting Ghost-Stack. Happy coding.${C_RESET}\n"
                        exit 0
                        ;;
                    *)
                        echo -e "\n${C_RED}Invalid option: $selected${C_RESET}"
                        sleep 0.6
                        ;;
                esac
            elif [[ $key == $'\177' || $key == $'\b' ]]; then
                choice="${choice%?}"
                echo -ne "\r  ${C_LIGHT_G}${C_BOLD}ghost-stack > ${C_RESET}${choice}\033[K"
            else
                choice="${choice}${key}"
                echo -ne "\r  ${C_LIGHT_G}${C_BOLD}ghost-stack > ${C_RESET}${choice}\033[K"
                if [[ "$choice" =~ ^[1-8sShHdDrRqQ0cC]$ ]]; then
                    local selected="$choice"
                    choice=""
                    need_clear=true
                    case "$selected" in
                        [rR]) continue ;;
                        1) handle_tui_category "ANDROID DEVELOPMENT" "TOOLS_ANDROID" "android" ;;
                        2) handle_tui_category "IOS DEVELOPMENT (LINUX STACK)" "TOOLS_IOS" "ios" ;;
                        3) handle_tui_category "WEB DEVELOPMENT" "TOOLS_WEB" "web" ;;
                        4) handle_tui_category "AI & MACHINE LEARNING" "TOOLS_AI" "ai" ;;
                        5) handle_tui_category "DEVELOPMENT SOFTWARES & IDES" "TOOLS_SOFTWARE" "tools" ;;
                        6) handle_tui_category "CORE SYSTEM TOOLS & DEVOPS" "TOOLS_CORE" "core" ;;
                        7|[cC]) run_system_cleaner; continue ;;
                        8) run_create_desktop_app; continue ;;
                        [sS]) cli_scan ""; pause ;;
                        [dD]) cli_doctor; pause ;;
                        [hH]) handle_help_menu ;;
                        0|[qQ])
                            echo -e "\n${C_LIGHT_G}Exiting Ghost-Stack. Happy coding.${C_RESET}\n"
                            exit 0
                            ;;
                    esac
                fi
            fi
        else
            # 1-second timeout: check if telemetry values changed
            local cur_cpu cur_ram
            cur_cpu=$(get_cpu_speed)
            cur_ram=$(get_mem_info)
            if [ "$cur_cpu" != "$last_cpu" ] || [ "$cur_ram" != "$last_ram" ]; then
                last_cpu="$cur_cpu"
                last_ram="$cur_ram"
                update_telemetry_in_place "$cur_cpu" "$cur_ram"
            fi
        fi
    done
}

# ==============================================================================
# CLI DISPATCH ROUTER
# ==============================================================================
case "$1" in
    scan|-s|--scan)
        cli_scan "$2"
        ;;
    install|-i|--install)
        cli_install "$2" "$3"
        ;;
    doctor|-d|--doctor)
        cli_doctor
        ;;
    clean|cleaner|cleanup)
        run_system_cleaner
        exit $?
        ;;
    desktop|app|create-desktop)
        run_create_desktop_app
        exit $?
        ;;
    install-cli|--install-cli)
        cli_install_binary
        ;;
    list|-l|--list)
        cli_list "$2"
        ;;
    help|-h|--help)
        if [ -n "$2" ]; then
            case "$2" in
                getting-started|start|01) render_help_getting_started ;;
                commands|cli|02)          render_help_commands ;;
                toolchains|tools|03)      render_help_toolchains ;;
                troubleshooting|faq|04)   render_help_troubleshooting ;;
                *) cli_help ;;
            esac
        else
            cli_help
        fi
        exit 0
        ;;
    --version|-v)
        echo -e "  ${C_LIGHT_G}${C_BOLD}[+] GHOST-STACK // v3.1.0 (${ARCH} // ${OS_NAME}) [+]${C_RESET}"
        exit 0
        ;;
    "")
        tui_main
        ;;
    *)
        echo -e "${C_RED}Unknown command: $1${C_RESET}"
        echo "Use 'ghost-stack --help' for usage instructions."
        exit 1
        ;;
esac
