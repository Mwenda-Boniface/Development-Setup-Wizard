install_cocoapods() {
    echo -e "${C_MINT}Installing Ruby and CocoaPods...${C_RESET}"
    pkg_install ruby ruby-dev build-essential
    if [ "$IS_TERMUX" = true ]; then
        gem install cocoapods || true
    else
        sudo gem install cocoapods || true
    fi
}

check_fastlane() { command -v fastlane >/dev/null 2>&1; }
install_fastlane() {
    echo -e "${C_MINT}Installing Fastlane (Mobile Deployment Automation)...${C_RESET}"
