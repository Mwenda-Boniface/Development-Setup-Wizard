get_category_array_name() {
    case "$1" in
        android|1) echo "TOOLS_ANDROID" ;;
        ios|2)     echo "TOOLS_IOS" ;;
        web|3)     echo "TOOLS_WEB" ;;
        ai|4)      echo "TOOLS_AI" ;;
        software|tools|5) echo "TOOLS_SOFTWARE" ;;
        core|git|devops|6) echo "TOOLS_CORE" ;;
        *) return 1 ;;
    esac
}

get_category_title() {
    case "$1" in
        android|1) echo "ANDROID DEVELOPMENT" ;;
        ios|2)     echo "IOS DEVELOPMENT (LINUX TOOLS)" ;;
        web|3)     echo "WEB DEVELOPMENT" ;;
        ai|4)      echo "AI & MACHINE LEARNING DEVELOPMENT" ;;
        software|tools|5) echo "DEVELOPMENT SOFTWARES & IDES" ;;
        core|git|devops|6) echo "CORE SYSTEM TOOLS & DEVOPS" ;;
        *) echo "UNKNOWN CATEGORY" ;;
    esac
}

# ==============================================================================
# CLI EXECUTION MODES
# ==============================================================================
cli_scan() {
    local target_cat="$1"

    if [ -n "$target_cat" ]; then
        local arr_name
        arr_name=$(get_category_array_name "$target_cat") || {
            echo -e "${C_RED}Error: Unknown category '$target_cat'.${C_RESET}"
            echo "Available categories: android, ios, web, ai, tools, core"
            exit 1
        }
        local title
        title=$(get_category_title "$target_cat")
        echo -e "${C_DARK_G}┌─[ ${C_LIGHT_G}${C_BOLD}DIAGNOSTIC SCAN: $title${C_RESET}${C_DARK_G} ]${C_RESET}"
        eval "local tools=(\"\${${arr_name}[@]}\")"
        local missing=0
        for item in "${tools[@]}"; do
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            if $check_fn; then
                badge_ok "$name"
            else
                badge_missing "$name"
                ((missing++))
            fi
        done
        echo -e "${C_DARK_G}└─────────────────────────────────────────────────────────${C_RESET}"
        [ "$missing" -eq 0 ] && exit 0 || exit 1
    fi

    draw_banner
    echo -e "  ${C_WHITE}${C_BOLD}COMPREHENSIVE TOOLCHAIN DIAGNOSTIC SCAN (EXECUTOR: ${CURRENT_USER})${C_RESET}\n"

    local categories=("TOOLS_ANDROID" "TOOLS_IOS" "TOOLS_WEB" "TOOLS_AI" "TOOLS_SOFTWARE" "TOOLS_CORE")
    local titles=("ANDROID DEVELOPMENT" "IOS DEVELOPMENT (LINUX TOOLS)" "WEB DEVELOPMENT" "AI & MACHINE LEARNING" "DEVELOPMENT SOFTWARES" "CORE SYSTEM TOOLS & DEVOPS")

    local total_checked=0
    local total_passed=0

    for idx in "${!categories[@]}"; do
        echo -e "${C_DARK_G}┌─[ ${C_LIGHT_G}${C_BOLD}${titles[$idx]}${C_RESET}${C_DARK_G} ]${C_RESET}"
        eval "local tools=(\"\${${categories[$idx]}[@]}\")"
        for item in "${tools[@]}"; do
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            ((total_checked++))
            if $check_fn; then
                badge_ok "$name"
                ((total_passed++))
            else
                badge_missing "$name"
            fi
        done
        echo -e "${C_DARK_G}└─────────────────────────────────────────────────────────${C_RESET}\n"
    done

    echo -e "  ${C_WHITE}${C_BOLD}Scan Summary:${C_RESET} ${C_LIGHT_G}$total_passed${C_RESET} of ${C_WHITE}$total_checked${C_RESET} tools verified."
    if [ "$total_passed" -eq "$total_checked" ]; then
        echo -e "  ${C_LIGHT_G}${C_BOLD}Status: All required developer tools are verified!${C_RESET}\n"
        exit 0
    else
        echo -e "  ${C_YELLOW}${C_BOLD}Status: Missing tools detected.${C_RESET}\n"
        exit 1
    fi
}

cli_install() {
    local cat_input="$1"
    local tools_input="$2"

    if [ -z "$cat_input" ]; then
        echo -e "${C_RED}Error: Category required. Example: ghost-stack install web 1,3 or ghost-stack install ai all${C_RESET}"
        exit 1
    fi

    local arr_name
    arr_name=$(get_category_array_name "$cat_input") || {
        echo -e "${C_RED}Error: Unknown category '$cat_input'.${C_RESET}"
        echo "Valid categories: android, ios, web, ai, tools, core"
        exit 1
    }

    eval "local tools=(\"\${${arr_name}[@]}\")"
    local uninstalled_names=()
    local uninstalled_installers=()

    for item in "${tools[@]}"; do
        local name="${item%%|*}"
        local rest="${item#*|}"
        local check_fn="${rest%%|*}"
        local install_fn="${rest#*|}"
        if ! $check_fn; then
            uninstalled_names+=("$name")
            uninstalled_installers+=("$install_fn")
        fi
    done

    if [ ${#uninstalled_names[@]} -eq 0 ]; then
        echo -e "${C_LIGHT_G}[OK] All tools in category '$cat_input' are already installed.${C_RESET}"
        exit 0
    fi

    if [ -z "$tools_input" ]; then
        echo -e "${C_YELLOW}Missing tools in category '$cat_input':${C_RESET}"
        for i in "${!uninstalled_names[@]}"; do
            echo -e "  [ $((i+1)) ] ${uninstalled_names[$i]}"
        done
        echo ""
        echo "Run with selection, e.g.: ghost-stack install $cat_input 1,2 or ghost-stack install $cat_input all"
        exit 0
    fi

    if [ "$tools_input" = "all" ] || [ "$tools_input" = "ALL" ]; then
        echo -e "${C_MINT}Installing all missing tools in category '$cat_input'...${C_RESET}"
        for i in "${!uninstalled_installers[@]}"; do
            echo -e "\n${C_DARK_G}>>> [ $((i+1)) / ${#uninstalled_installers[@]} ] Installing: ${uninstalled_names[$i]}${C_RESET}"
            ${uninstalled_installers[$i]}
        done
    else
        IFS=',' read -ra SELECTED <<< "$tools_input"
        for sel in "${SELECTED[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#uninstalled_names[@]}" ]; then
                local idx=$((sel - 1))
                echo -e "\n${C_DARK_G}>>> Installing: ${uninstalled_names[$idx]}${C_RESET}"
                ${uninstalled_installers[$idx]}
            else
                echo -e "${C_RED}Skipping invalid selection index: $sel${C_RESET}"
            fi
        done
    fi

    sync_env
    persist_env
    auto_stamp_desktop
    echo -e "\n${C_LIGHT_G}${C_BOLD}[OK] Batch installation completed.${C_RESET}"
}

cli_install_binary() {
    mkdir -p "$CURRENT_HOME/.local/bin" "$CURRENT_HOME/.local/share/applications" "$CURRENT_HOME/Desktop"
    ln -sf "$REAL_SCRIPT_PATH" "$CURRENT_HOME/.local/bin/ghost-stack"
    ln -sf "$REAL_SCRIPT_PATH" "$CURRENT_HOME/.local/bin/dev-wizard"
    chmod +x "$CURRENT_HOME/.local/bin/ghost-stack" "$CURRENT_HOME/.local/bin/dev-wizard"
    
    # Stamp desktop launcher dynamically
    if [ -f "$ROOT_DIR/Dev-Setup-Wizard.desktop" ]; then
        cp "$ROOT_DIR/Dev-Setup-Wizard.desktop" "$CURRENT_HOME/Desktop/Dev-Setup-Wizard.desktop"
        cp "$ROOT_DIR/Dev-Setup-Wizard.desktop" "$CURRENT_HOME/.local/share/applications/dev-setup-wizard.desktop"
        auto_stamp_desktop
    fi
    
    persist_env
    echo -e "${C_LIGHT_G}${C_BOLD}[OK] 'ghost-stack' has been installed to $CURRENT_HOME/.local/bin/ghost-stack${C_RESET}"
    echo -e "${C_LIGHT_G}${C_BOLD}[OK] 'dev-wizard' alias symlink created${C_RESET}"
    echo -e "${C_LIGHT_G}${C_BOLD}[OK] Desktop launcher stamped and signed for user: ${CURRENT_USER}${C_RESET}"
    echo -e "You can now run ${C_WHITE}${C_BOLD}ghost-stack${C_RESET} directly from any terminal directory!"
}

cli_doctor() {
    sync_env
    draw_banner
    echo -e "  ${C_WHITE}${C_BOLD}FLUTTER & ANDROID TOOLCHAIN DOCTOR (USER: ${CURRENT_USER})${C_RESET}\n"
    if command -v flutter >/dev/null 2>&1; then
        flutter doctor -v
    elif [ -x "$FLUTTER_DIR/bin/flutter" ]; then
        "$FLUTTER_DIR/bin/flutter" doctor -v
    else
        echo -e "${C_RED}Flutter binary not found. Install it via 'ghost-stack install android 9'.${C_RESET}"
        exit 1
    fi
}

