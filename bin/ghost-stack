#!/usr/bin/env bash
# ==============================================================================
# GHOST-STACK // SYSTEM & TOOLCHAIN ORCHESTRATOR
# Version: 3.1.0
# Author: Mwenda Boniface (https://github.com/Mwenda-Boniface)
# Platform: Linux (Debian, Ubuntu, Kali, Mint, Pop!_OS) & Android (Termux)
# Style: Cyberpunk Terminal Green (Strictly Zero Emojis)
# Architecture: 100% Dynamic User, Multi-User Agnostic, Termux-Compatible
# ==============================================================================

set -o pipefail

# Ensure bash execution
if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

# ==============================================================================
# PLATFORM & ENVIRONMENT RESOLUTION (LINUX / TERMUX)
# ==============================================================================
IS_TERMUX=false
if [ -n "$TERMUX_VERSION" ] || [ -d "/data/data/com.termux" ] || [[ "${PREFIX:-}" =~ "com.termux" ]]; then
    IS_TERMUX=true
fi

CURRENT_USER="$(id -un 2>/dev/null || whoami)"
CURRENT_HOME="${HOME:-/home/$CURRENT_USER}"

REAL_SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$REAL_SCRIPT_PATH")/.." && pwd)"

DEV_DIR="$CURRENT_HOME/development"
FLUTTER_DIR="$DEV_DIR/flutter"
ANDROID_DIR="$CURRENT_HOME/Android/Sdk"

# Architecture detection
ARCH="$(uname -m 2>/dev/null || echo "unknown")"
OS_NAME="Linux"
if [ "$IS_TERMUX" = true ]; then
    OS_NAME="Android (Termux)"
elif [ -f /etc/os-release ]; then
    OS_NAME=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')
fi

# Temporary directory resolution (Termux uses $PREFIX/tmp or $TMPDIR)
TMP_DIR="${TMPDIR:-/tmp}"
if [ "$IS_TERMUX" = true ] || [ ! -w "$TMP_DIR" ]; then
    TMP_DIR="${PREFIX:-$CURRENT_HOME}/tmp"
    [ ! -d "$TMP_DIR" ] && TMP_DIR="$CURRENT_HOME/.tmp"
fi
mkdir -p "$TMP_DIR" 2>/dev/null || true

# Java path resolution
JAVA_21_PATH="/usr/lib/jvm/java-21-openjdk-amd64"
JAVA_17_PATH="/usr/lib/jvm/java-17-openjdk-amd64"
if [ "$IS_TERMUX" = true ]; then
    JAVA_PREFERRED_PATH="${PREFIX:-/data/data/com.termux/files/usr}/lib/jvm/java-17-openjdk"
elif [ -d "$JAVA_21_PATH" ]; then
    JAVA_PREFERRED_PATH="$JAVA_21_PATH"
elif [ -d "$JAVA_17_PATH" ]; then
    JAVA_PREFERRED_PATH="$JAVA_17_PATH"
else
    JAVA_PREFERRED_PATH="/usr/lib/jvm/default-java"
fi

# Package manager abstraction (Debian apt vs Termux pkg)
APT_UPDATED=false
pkg_install() {
    if [ "$IS_TERMUX" = true ]; then
        pkg install -y "$@" || apt-get install -y "$@"
    else
        if [ "$APT_UPDATED" = false ]; then
            echo -e "${C_GRAY}Synchronizing package repositories (apt update)...${C_RESET}"
            sudo apt update && APT_UPDATED=true
        fi
        sudo apt install -y "$@"
    fi
}

# ==============================================================================
# COLOR PALETTE (TERMINAL GREEN // ZERO EMOJIS)
# ==============================================================================
C_LIGHT_G="\033[1;32m"      # Classic vibrant light green
C_MINT="\033[38;5;84m"      # Crisp readable mint green
C_DARK_G="\033[38;5;29m"    # Deep border green
C_WHITE="\033[1;37m"        # High contrast bold white
C_GRAY="\033[38;5;244m"     # Technical muted gray
C_RED="\033[1;31m"          # Failure / missing
C_YELLOW="\033[1;33m"       # Warning / attention
C_CYAN="\033[1;36m"         # Accent cyan
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

# Status Badges (Strictly Zero Emojis)
badge_ok()      { echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ]${C_RESET}       $1"; }
badge_missing() { echo -e "  ${C_RED}${C_BOLD}[ MISSING ]${C_RESET}  $1"; }
badge_warn()    { echo -e "  ${C_YELLOW}${C_BOLD}[ WARN ]${C_RESET}     $1"; }
badge_info()    { echo -e "  ${C_MINT}${C_BOLD}[ INFO ]${C_RESET}     $1"; }

# ==============================================================================
# ENVIRONMENT & DESKTOP AUTO-STAMPING
# ==============================================================================
sync_env() {
    if [ -d "$JAVA_PREFERRED_PATH" ]; then
        export JAVA_HOME="$JAVA_PREFERRED_PATH"
    fi
    export ANDROID_HOME="$ANDROID_DIR"
    local termux_prefix_bin="${PREFIX:-/data/data/com.termux/files/usr}/bin"
    if [ "$IS_TERMUX" = true ]; then
        export PATH="$CURRENT_HOME/.local/bin:$termux_prefix_bin:$CURRENT_HOME/.cargo/bin:$CURRENT_HOME/go/bin:$CURRENT_HOME/.bun/bin:$CURRENT_HOME/.deno/bin:$FLUTTER_DIR/bin:$ANDROID_DIR/cmdline-tools/latest/bin:$ANDROID_DIR/platform-tools:${JAVA_HOME:-/usr}/bin:$PATH"
    else
        export PATH="$CURRENT_HOME/.local/bin:$CURRENT_HOME/.cargo/bin:$CURRENT_HOME/go/bin:$CURRENT_HOME/.bun/bin:$CURRENT_HOME/.deno/bin:$FLUTTER_DIR/bin:$ANDROID_DIR/cmdline-tools/latest/bin:$ANDROID_DIR/platform-tools:${JAVA_HOME:-/usr}/bin:$PATH"
    fi
}
sync_env

persist_env() {
    local env_block="
# --- GHOST-STACK ENVIRONMENT PATHS (USER: $CURRENT_USER) ---
export JAVA_HOME=\"${JAVA_PREFERRED_PATH}\"
export ANDROID_HOME=\"\$HOME/Android/Sdk\"
export PATH=\"\$HOME/.local/bin:\$HOME/.cargo/bin:\$HOME/go/bin:\$HOME/.bun/bin:\$HOME/.deno/bin:\$HOME/development/flutter/bin:\$ANDROID_HOME/cmdline-tools/latest/bin:\$ANDROID_HOME/platform-tools:\$JAVA_HOME/bin:\$PATH\"
# ----------------------------------------------------------"

    for rc in "$CURRENT_HOME/.zshrc" "$CURRENT_HOME/.bashrc"; do
        if [ -f "$rc" ]; then
            if ! grep -q "GHOST-STACK ENVIRONMENT PATHS" "$rc" && ! grep -q "ANDROID_HOME" "$rc"; then
                echo "$env_block" >> "$rc"
            fi
        fi
    done
}
persist_env

auto_stamp_desktop() {
    if [ "$IS_TERMUX" = true ]; then
        return 0
    fi
    local desktop_targets=(
        "$CURRENT_HOME/Desktop/Ghost-Stack.desktop"
        "$ROOT_DIR/Ghost-Stack.desktop"
        "$CURRENT_HOME/.local/share/applications/ghost-stack.desktop"
    )
    for dt in "${desktop_targets[@]}"; do
        if [ -f "$dt" ] && command -v gio >/dev/null 2>&1; then
            chmod +x "$dt" 2>/dev/null || true
            local sum
            sum=$(sha256sum "$dt" 2>/dev/null | awk '{print $1}')
            if [ -n "$sum" ]; then
                gio set -t string "$dt" metadata::xfce-exe-checksum "$sum" 2>/dev/null || true
            fi
        fi
    done
    rm -f "$CURRENT_HOME/Desktop/Dev-Setup-Wizard.desktop" "$CURRENT_HOME/.local/share/applications/dev-setup-wizard.desktop" 2>/dev/null || true
}
auto_stamp_desktop

# ==============================================================================
# UI RENDERERS & TELEMETRY
# ==============================================================================
draw_banner() {
    clear
    echo -e "${C_LIGHT_G}${C_BOLD}"
    cat << "EOF"
   ________               __       _____ __             __  
  / ____/ /_  ____  _____/ /_     / ___// /_____ ______/ /__
 / / __/ __ \/ __ \/ ___/ __/_____\__ \/ __/ __ `/ ___/ //_/
/ /_/ / / / / /_/ (__  ) /_/_____/__/ / /_/ /_/ / /__/ ,<   
\____/_/ /_/\____/____/\__/     /____/\__/\__,_/\___/_/|_|  
EOF
    echo -e "${C_RESET}"
    echo -e "       ${C_WHITE}${C_BOLD}[ + ]   C O D E   B Y   M W E N D A   B O N I F A C E   [ + ]${C_RESET}\n"
}

get_cpu_speed() {
    local speed=""
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]; then
        local khz
        khz=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
        if [ -n "$khz" ] && [ "$khz" -gt 0 ] 2>/dev/null; then
            speed=$(awk -v k="$khz" 'BEGIN {printf "%.2f GHz", k/1000000}')
        fi
    fi
    if [ -z "$speed" ] && [ -f /proc/cpuinfo ]; then
        local mhz
        mhz=$(awk -F: '/cpu MHz/{print $2; exit}' /proc/cpuinfo 2>/dev/null | xargs)
        if [ -n "$mhz" ]; then
            speed=$(awk -v m="$mhz" 'BEGIN {printf "%.2f GHz", m/1000}')
        fi
    fi
    if [ -z "$speed" ] && command -v lscpu >/dev/null 2>&1; then
        local max_mhz
        max_mhz=$(lscpu 2>/dev/null | awk -F: '/CPU max MHz/{print $2}' | xargs)
        if [ -n "$max_mhz" ]; then
            speed=$(awk -v m="$max_mhz" 'BEGIN {printf "%.2f GHz", m/1000}')
        fi
    fi
    if [ -z "$speed" ] && [ -f /proc/cpuinfo ]; then
        speed=$(grep -m 1 "model name" /proc/cpuinfo 2>/dev/null | sed -n 's/.*@ *\([0-9.]*[A-Za-z]*Hz\).*/\1/p')
    fi
    [ -z "$speed" ] && speed="N/A"
    echo "$speed"
}

get_mem_info() {
    if command -v free >/dev/null 2>&1; then
        free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2 " (" $7 " Free)"}'
    elif [ -f /proc/meminfo ]; then
        awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END {printf "%.1fG / %.1fG (%.1fG Free)\n", (t-a)/1024/1024, t/1024/1024, a/1024/1024}' /proc/meminfo 2>/dev/null
    else
        echo "N/A"
    fi
}

get_disk_info() {
    local dinfo
    dinfo=$(df -h "$ROOT_DIR" 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $4 " Free)"}')
    if [ -z "$dinfo" ]; then
        dinfo=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $4 " Free)"}')
    fi
    [ -z "$dinfo" ] && dinfo="N/A"
    echo "$dinfo"
}

draw_telemetry_col() {
    local label="$1"
    local val="$2"
    local width="$3"
    local padded_label
    printf -v padded_label "%-16s" "$label"
    local max_val_len=$(( width - 22 ))
    if [ "${#val}" -gt "$max_val_len" ]; then
        val="...${val: -$((max_val_len - 3))}"
    fi
    local visible_len=$(( 4 + 16 + 2 + ${#val} ))
    local pad=0
    if [ "$visible_len" -lt "$width" ]; then
        pad=$((width - visible_len))
    fi
    printf "${C_MINT}[*] %s:${C_RESET} ${C_WHITE}%s${C_RESET}%*s" "$padded_label" "$val" "$pad" ""
}

draw_telemetry_row() {
    local l_lbl="$1" l_val="$2" r_lbl="$3" r_val="$4"
    echo -en "  ${C_GRAY}│${C_RESET}   "
    draw_telemetry_col "$l_lbl" "$l_val" 48
    echo -en "  "
    draw_telemetry_col "$r_lbl" "$r_val" 48
    echo -e "   ${C_GRAY}│${C_RESET}"
}

draw_home_telemetry() {
    local platform_label
    if [ "$IS_TERMUX" = true ]; then
        platform_label="Android (Termux PKG)"
    else
        platform_label="Native Linux (APT)"
    fi

    local cpu_speed mem_info disk_info display_workspace term_cols
    cpu_speed=$(get_cpu_speed)
    mem_info=$(get_mem_info)
    disk_info=$(get_disk_info)
    display_workspace=$(echo "$ROOT_DIR" | sed "s|^$HOME|~|")
    shopt -s checkwinsize 2>/dev/null || true
    local term_cols="${GHOST_STACK_COLS:-${COLUMNS:-}}"
    if [ -z "$term_cols" ] || [ "$term_cols" -eq 0 ] 2>/dev/null; then
        term_cols=$(tput cols 2>/dev/null || echo 80)
    fi

    if [ "$term_cols" -ge 104 ]; then
        # Wide / Maximized Mode: Dual-Column Tabular Grid
        echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM ENVIRONMENT TELEMETRY${C_RESET} ${C_GRAY}]$(printf "%0.s─" {1..71})┐${C_RESET}"
        echo -e "  ${C_GRAY}│$(printf "%0.s " {1..104})│${C_RESET}"
        draw_telemetry_row "Architecture" "$ARCH" "CPU Speed" "$cpu_speed"
        draw_telemetry_row "Operating System" "$OS_NAME" "Active Session" "$CURRENT_USER"
        draw_telemetry_row "Memory (RAM)" "$mem_info" "Disk Storage" "$disk_info"
        draw_telemetry_row "Runtime Platform" "$platform_label" "Workspace Path" "$display_workspace"
        echo -e "  ${C_GRAY}│$(printf "%0.s " {1..104})│${C_RESET}"
        echo -e "  ${C_GRAY}└$(printf "%0.s─" {1..104})┘${C_RESET}"
    else
        # Standard / Compact Mode (<= 80-100 columns): Fits cleanly without wrapping
        echo -e "  ${C_GRAY}┌─[ ${C_WHITE}${C_BOLD}SYSTEM ENVIRONMENT TELEMETRY${C_RESET} ${C_GRAY}]──────────────────────────────────────┐${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}   ${C_MINT}[*] Architecture     :${C_RESET}  ${C_WHITE}${ARCH}${C_RESET} ${C_GRAY}(${cpu_speed})${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}   ${C_MINT}[*] Operating System :${C_RESET}  ${C_WHITE}${OS_NAME}${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}   ${C_MINT}[*] Active Session   :${C_RESET}  ${C_WHITE}${CURRENT_USER}${C_RESET} ${C_GRAY}(${platform_label})${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}   ${C_MINT}[*] Memory (RAM)     :${C_RESET}  ${C_WHITE}${mem_info}${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}   ${C_MINT}[*] Disk Storage     :${C_RESET}  ${C_WHITE}${disk_info}${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}   ${C_MINT}[*] Workspace Path   :${C_RESET}  ${C_WHITE}${display_workspace}${C_RESET}"
        echo -e "  ${C_GRAY}│${C_RESET}"
        echo -e "  ${C_GRAY}└──────────────────────────────────────────────────────────────────────────────┘${C_RESET}"
    fi
    echo ""
}

pause() {
    echo ""
    echo -e "${C_GRAY}Press [Enter] to continue...${C_RESET}"
    read -r || true
}

# ==============================================================================
# TOOL IMPLEMENTATIONS (CHECKS & INSTALLERS)
# ==============================================================================

# --- [01. ANDROID DEVELOPMENT] ---
check_java21() {
    if [ "$IS_TERMUX" = true ]; then
        command -v java >/dev/null 2>&1
    else
        [ -d "$JAVA_21_PATH" ] || (command -v java >/dev/null && java -version 2>&1 | grep -q "21\.")
    fi
}
install_java21() {
    echo -e "${C_MINT}Installing OpenJDK...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install openjdk-17
    else
        pkg_install openjdk-21-jdk
    fi
    sync_env
}

check_java17() {
    [ -d "$JAVA_17_PATH" ] || (command -v java >/dev/null && java -version 2>&1 | grep -q "17\.")
}
install_java17() {
    echo -e "${C_MINT}Installing OpenJDK 17 LTS (Gradle fallback)...${C_RESET}"
    pkg_install openjdk-17-jdk
    sync_env
}

check_android_cmdline() { [ -x "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" ]; }
install_android_cmdline() {
    check_java21 || check_java17 || install_java21
    echo -e "${C_MINT}Downloading Android Command-Line Tools (sdkmanager)...${C_RESET}"
    mkdir -p "$ANDROID_DIR/cmdline-tools" "$TMP_DIR"
    local zip_file="$TMP_DIR/cmdline-tools.zip"
    curl -L -o "$zip_file" "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
    unzip -q -o "$zip_file" -d "$TMP_DIR/cmdline-extract"
    mkdir -p "$ANDROID_DIR/cmdline-tools/latest"
    cp -r "$TMP_DIR"/cmdline-extract/cmdline-tools/* "$ANDROID_DIR/cmdline-tools/latest/"
    chmod +x "$ANDROID_DIR/cmdline-tools/latest/bin/"* 2>/dev/null || true
    rm -rf "$TMP_DIR/cmdline-extract" "$zip_file"
    sync_env
}

check_android_platform_tools() { [ -x "$ANDROID_DIR/platform-tools/adb" ] || command -v adb >/dev/null 2>&1; }
install_android_platform_tools() {
    echo -e "${C_MINT}Installing Android Platform-Tools (adb, fastboot)...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install android-tools
    else
        check_android_cmdline || install_android_cmdline
        sync_env
        echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "platform-tools"
    fi
}

check_android_platforms() { [ -d "$ANDROID_DIR/platforms/android-36" ] || [ -d "$ANDROID_DIR/platforms/android-34" ]; }
install_android_platforms() {
    echo -e "${C_MINT}Installing Android SDK Platforms (API 34 & 36)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "platforms;android-36" "platforms;android-34"
}

check_android_build_tools() { [ -d "$ANDROID_DIR/build-tools/28.0.3" ] || [ -d "$ANDROID_DIR/build-tools/34.0.0" ]; }
install_android_build_tools() {
    echo -e "${C_MINT}Installing Android Build-Tools (28.0.3 & 34.0.0)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "build-tools;28.0.3" "build-tools;34.0.0"
}

check_android_ndk() { [ -d "$ANDROID_DIR/ndk" ] && [ "$(ls -A "$ANDROID_DIR/ndk" 2>/dev/null)" ]; }
install_android_ndk() {
    echo -e "${C_MINT}Installing Android NDK (Native Development Kit)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "ndk;26.2.11394342" || echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "ndk-bundle"
}

check_gradle() { command -v gradle >/dev/null 2>&1; }
install_gradle() {
    echo -e "${C_MINT}Installing Gradle Build Tool...${C_RESET}"
    pkg_install gradle
}

check_flutter() { [ -x "$FLUTTER_DIR/bin/flutter" ] || command -v flutter >/dev/null 2>&1; }
install_flutter() {
    echo -e "${C_MINT}Cloning Flutter SDK (stable channel)...${C_RESET}"
    mkdir -p "$DEV_DIR"
    if [ ! -d "$FLUTTER_DIR" ]; then
        git clone https://github.com/flutter/flutter.git -b stable "$FLUTTER_DIR"
    else
        cd "$FLUTTER_DIR" && git pull || true
    fi
    sync_env
    "$FLUTTER_DIR/bin/flutter" precache
    "$FLUTTER_DIR/bin/flutter" config --android-sdk "$ANDROID_DIR" || true
    yes | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" --licenses 2>/dev/null || true
}

check_scrcpy() { command -v scrcpy >/dev/null 2>&1; }
install_scrcpy() {
    echo -e "${C_MINT}Installing Scrcpy (Android Screen Mirroring over USB)...${C_RESET}"
    pkg_install scrcpy
}

