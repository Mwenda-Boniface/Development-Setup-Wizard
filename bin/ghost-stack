# ==============================================================================
# INTERACTIVE TUI HANDLERS
# ==============================================================================
handle_tui_category() {
    local cat_title="$1"
    local cat_array_name="$2"
    local cat_slug="$3"

    eval "local tool_list=(\"\${${cat_array_name}[@]}\")"
    local total_tools=${#tool_list[@]}

    while true; do
        draw_banner
        local t_cols
        t_cols=$(get_current_cols)
        if [ "$t_cols" -ge 65 ]; then
            echo -e "       ${C_WHITE}${C_BOLD}[ + ]   $cat_title   [ + ]${C_RESET}\n"
        else
            echo -e "  ${C_WHITE}${C_BOLD}[+] $cat_title [+]${C_RESET}\n"
        fi

        local installed_count=0
        local uninstalled_names=()
        local uninstalled_installers=()
        local uninstalled_checkers=()

        for idx in "${!tool_list[@]}"; do
            local item="${tool_list[$idx]}"
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            local install_fn="${rest#*|}"

            if $check_fn; then
                badge_ok "$name"
                ((installed_count++))
            else
                badge_missing "$name"
                uninstalled_names+=("$name")
                uninstalled_installers+=("$install_fn")
                uninstalled_checkers+=("$check_fn")
            fi
        done

        echo ""
        draw_divider
        echo -e "  ${C_WHITE}${C_BOLD}Status:${C_RESET} ${C_LIGHT_G}$installed_count${C_RESET} of ${C_WHITE}$total_tools${C_RESET} tools verified."
        draw_divider

        if [ ${#uninstalled_names[@]} -eq 0 ]; then
            echo -e "\n  ${C_LIGHT_G}${C_BOLD}[ OK ] All tools in this discipline are verified and active.${C_RESET}\n"
            echo -e "  ${C_WHITE}[ R ]${C_RESET} ${C_LIGHT_G}Force reinstall / re-run a specific tool${C_RESET}"
            echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_GRAY}Return to Main Menu${C_RESET}"
            echo ""
            echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(${cat_slug}) > ${C_RESET}"
            read -r r_choice || return 0
            if [[ "$r_choice" =~ ^[Rr]$ ]]; then
                echo -ne "\n  Enter tool number to re-run (1-$total_tools): "
                read -r re_idx || continue
                if [[ "$re_idx" =~ ^[0-9]+$ ]] && [ "$re_idx" -ge 1 ] && [ "$re_idx" -le "$total_tools" ]; then
                    local target_item="${tool_list[$((re_idx-1))]}"
                    local t_rest="${target_item#*|}"
                    local t_install="${t_rest#*|}"
                    $t_install
                    pause
                fi
                continue
            else
                return 0
            fi
        fi

        echo -e "\n  ${C_WHITE}${C_BOLD}Select uninstalled tools to provision:${C_RESET}"
        draw_divider
        for u_idx in "${!uninstalled_names[@]}"; do
            echo -e "  ${C_WHITE}[ $((u_idx + 1)) ]${C_RESET} ${C_LIGHT_G}${uninstalled_names[$u_idx]}${C_RESET}"
        done
        echo -e "  ${C_WHITE}[ A ]${C_RESET} ${C_LIGHT_G}Install ALL uninstalled tools listed above${C_RESET}"
        echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_GRAY}Return to Main Menu${C_RESET}"
        draw_divider
        echo ""
        echo -e "  ${C_GRAY}Enter numbers separated by commas (e.g. 1,2 or 1,3 or 'A' or '0'):${C_RESET}"
        echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(${cat_slug}) > ${C_RESET}"
        read -r user_selection || return 0

        if [[ "$user_selection" =~ ^[0bBqQ]$ ]] || [[ "$user_selection" =~ ^(back|exit|quit|menu)$ ]]; then
            return 0
        fi

        if [[ "$user_selection" =~ ^[Aa]$ ]]; then
            echo -e "\n${C_LIGHT_G}==> Provisioning all ${#uninstalled_names[@]} missing tools...${C_RESET}\n"
            local success_count=0
            local fail_count=0
            for u_idx in "${!uninstalled_names[@]}"; do
                echo -e "\n${C_DARK_G}>>> [ $((u_idx+1)) / ${#uninstalled_names[@]} ] Installing: ${C_WHITE}${uninstalled_names[$u_idx]}${C_RESET}"
                ${uninstalled_installers[$u_idx]}
                sync_env
                if ${uninstalled_checkers[$u_idx]}; then
                    echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ] Verified:${C_RESET} ${C_WHITE}${uninstalled_names[$u_idx]}${C_RESET} is active and verified."
                    ((success_count++))
                else
                    echo -e "  ${C_RED}${C_BOLD}[ FAILED ] Verification error:${C_RESET} ${C_YELLOW}${uninstalled_names[$u_idx]}${C_RESET} failed check after installation."
                    ((fail_count++))
                fi
            done
            sync_env
            persist_env
            auto_stamp_desktop
            if [ "$fail_count" -eq 0 ]; then
                echo -e "\n${C_LIGHT_G}${C_BOLD}[ OK ] Batch provisioning completed. All $success_count tools verified successfully.${C_RESET}"
            else
                echo -e "\n${C_YELLOW}${C_BOLD}[ ATTENTION ] Batch provisioning completed with issues: $success_count verified, $fail_count failed.${C_RESET}"
            fi
            pause
            continue
        fi

        IFS=',' read -ra SELECTED_ITEMS <<< "$user_selection"
        local success_count=0
        local fail_count=0
        for sel in "${SELECTED_ITEMS[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#uninstalled_names[@]}" ]; then
                local t_idx=$((sel - 1))
                echo -e "\n${C_DARK_G}>>> Installing: ${C_WHITE}${uninstalled_names[$t_idx]}${C_RESET}"
                ${uninstalled_installers[$t_idx]}
                sync_env
                if ${uninstalled_checkers[$t_idx]}; then
                    echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ] Verified:${C_RESET} ${C_WHITE}${uninstalled_names[$t_idx]}${C_RESET} is active and verified."
                    ((success_count++))
                else
                    echo -e "  ${C_RED}${C_BOLD}[ FAILED ] Verification error:${C_RESET} ${C_YELLOW}${uninstalled_names[$t_idx]}${C_RESET} failed check after installation."
                    ((fail_count++))
                fi
            else
                echo -e "${C_RED}Skipping invalid selection index: $sel${C_RESET}"
            fi
        done

        if [ $((success_count + fail_count)) -gt 0 ]; then
            sync_env
            persist_env
            auto_stamp_desktop
            if [ "$fail_count" -eq 0 ]; then
                echo -e "\n${C_LIGHT_G}${C_BOLD}[ OK ] Provisioning complete. All $success_count tools verified successfully.${C_RESET}"
            else
                echo -e "\n${C_YELLOW}${C_BOLD}[ ATTENTION ] Completed with issues: $success_count verified, $fail_count failed.${C_RESET}"
            fi
            pause
        fi
    done
}

G_WINCH_EVENT=false
on_winch_signal() {
    G_WINCH_EVENT=true
}
trap 'on_winch_signal' WINCH

render_home_dashboard() {
    local choice="$1"
    clear

    draw_banner --no-clear
    draw_home_telemetry

    local tier="$G_LAYOUT_TIER"
    case "$tier" in
        mobile)
            echo -e "  ${C_WHITE}[ 1 ]${C_RESET} ${C_LIGHT_G}Android Development${C_RESET}"
            echo -e "  ${C_WHITE}[ 2 ]${C_RESET} ${C_LIGHT_G}iOS Development (Linux Stack)${C_RESET}"
            echo -e "  ${C_WHITE}[ 3 ]${C_RESET} ${C_LIGHT_G}Web Development${C_RESET}"
            echo -e "  ${C_WHITE}[ 4 ]${C_RESET} ${C_LIGHT_G}AI & Machine Learning${C_RESET}"
            echo -e "  ${C_WHITE}[ 5 ]${C_RESET} ${C_LIGHT_G}Development Softwares & IDEs${C_RESET}"
            echo -e "  ${C_WHITE}[ 6 ]${C_RESET} ${C_LIGHT_G}Core System Tools & DevOps${C_RESET}"
            echo -e "  ${C_WHITE}[ 7 ]${C_RESET} ${C_LIGHT_G}System Cleaner & Diagnostics${C_RESET}"
            echo -e "  ${C_WHITE}[ 8 ]${C_RESET} ${C_LIGHT_G}Desktop App & Custom Logo${C_RESET}"
            echo -e "  ${C_WHITE}[S]${C_RESET} ${C_LIGHT_G}Scan${C_RESET}  ${C_WHITE}[D]${C_RESET} ${C_LIGHT_G}Doc${C_RESET}  ${C_WHITE}[H]${C_RESET} ${C_LIGHT_G}Help${C_RESET}  ${C_WHITE}[0]${C_RESET} ${C_LIGHT_G}Exit${C_RESET}"
            ;;
        tall)
            local t_lines
            t_lines=$(get_current_lines)
            if [ "$t_lines" -ge 32 ]; then
                echo -e "  ${C_WHITE}[ 1 ]${C_RESET} ${C_LIGHT_G}Android Development${C_RESET}"
                echo -e "  ${C_WHITE}[ 2 ]${C_RESET} ${C_LIGHT_G}iOS Development (Linux Stack)${C_RESET}"
                echo -e "  ${C_WHITE}[ 3 ]${C_RESET} ${C_LIGHT_G}Web Development${C_RESET}"
                echo -e "  ${C_WHITE}[ 4 ]${C_RESET} ${C_LIGHT_G}AI & Machine Learning${C_RESET}"
                echo -e "  ${C_WHITE}[ 5 ]${C_RESET} ${C_LIGHT_G}Development Softwares & IDEs${C_RESET}"
                echo -e "  ${C_WHITE}[ 6 ]${C_RESET} ${C_LIGHT_G}Core System Tools & DevOps${C_RESET}"
                echo -e "  ${C_WHITE}[ 7 ]${C_RESET} ${C_LIGHT_G}System Cleaner & Diagnostics${C_RESET}"
                echo -e "  ${C_WHITE}[ 8 ]${C_RESET} ${C_LIGHT_G}Desktop Launcher & Custom Logo${C_RESET}"
                echo -e "  ${C_WHITE}[ S ]${C_RESET} ${C_LIGHT_G}Full Diagnostic Scan${C_RESET}"
                echo -e "  ${C_WHITE}[ D ]${C_RESET} ${C_LIGHT_G}Flutter & Android Doctor${C_RESET}"
                echo -e "  ${C_WHITE}[ H ]${C_RESET} ${C_LIGHT_G}Help & Navigation Manual${C_RESET}"
                echo -e "  ${C_WHITE}[ R ]${C_RESET} ${C_LIGHT_G}Refresh Screen${C_RESET}"
                echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_LIGHT_G}Exit${C_RESET}"
            else
                echo -e "  ${C_WHITE}[ 1 ]${C_RESET} Android   ${C_WHITE}[ 2 ]${C_RESET} iOS       ${C_WHITE}[ 3 ]${C_RESET} Web       ${C_WHITE}[ 4 ]${C_RESET} AI/ML"
                echo -e "  ${C_WHITE}[ 5 ]${C_RESET} Softwares ${C_WHITE}[ 6 ]${C_RESET} DevOps    ${C_WHITE}[ 7 ]${C_RESET} Cleaner   ${C_WHITE}[ 8 ]${C_RESET} Desktop App"
                echo -e "  ${C_WHITE}[ S ]${C_RESET} Scan  ${C_WHITE}[ D ]${C_RESET} Doctor  ${C_WHITE}[ H ]${C_RESET} Help  ${C_WHITE}[ R ]${C_RESET} Refresh  ${C_WHITE}[ 0 ]${C_RESET} Exit"
            fi
            ;;
        medium)
            echo -e "  ${C_WHITE}[ 1 ]${C_RESET} Android   ${C_WHITE}[ 2 ]${C_RESET} iOS       ${C_WHITE}[ 3 ]${C_RESET} Web       ${C_WHITE}[ 4 ]${C_RESET} AI/ML"
            echo -e "  ${C_WHITE}[ 5 ]${C_RESET} Softwares ${C_WHITE}[ 6 ]${C_RESET} DevOps    ${C_WHITE}[ 7 ]${C_RESET} Cleaner   ${C_WHITE}[ 8 ]${C_RESET} Desktop App"
            echo -e "  ${C_WHITE}[ S ]${C_RESET} Scan  ${C_WHITE}[ D ]${C_RESET} Doctor  ${C_WHITE}[ H ]${C_RESET} Help  ${C_WHITE}[ R ]${C_RESET} Refresh  ${C_WHITE}[ 0 ]${C_RESET} Exit"
            ;;
        compact)
            echo -e "  ${C_WHITE}[1]${C_RESET}Android ${C_WHITE}[2]${C_RESET}iOS ${C_WHITE}[3]${C_RESET}Web ${C_WHITE}[4]${C_RESET}AI/ML ${C_WHITE}[5]${C_RESET}Tools ${C_WHITE}[6]${C_RESET}DevOps ${C_WHITE}[7]${C_RESET}Clean ${C_WHITE}[8]${C_RESET}App"
            echo -e "  ${C_WHITE}[S]${C_RESET}Scan  ${C_WHITE}[D]${C_RESET}Doctor  ${C_WHITE}[H]${C_RESET}Help  ${C_WHITE}[R]${C_RESET}Refresh  ${C_WHITE}[0]${C_RESET}Exit"
            ;;
        tiny)
            echo -e "  ${C_WHITE}[1-6]${C_RESET}Stacks  ${C_WHITE}[7]${C_RESET}Clean  ${C_WHITE}[8]${C_RESET}App  ${C_WHITE}[S]${C_RESET}Scan  ${C_WHITE}[D]${C_RESET}Doc  ${C_WHITE}[H]${C_RESET}Help  ${C_WHITE}[0]${C_RESET}Exit"
            ;;
