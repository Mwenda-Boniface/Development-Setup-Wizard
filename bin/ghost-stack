    if [ "$IS_TERMUX" = true ]; then
        echo -e "${C_YELLOW}Notice: DBeaver GUI requires desktop environment. Skipping on Termux.${C_RESET}"
        return 0
    fi
    local deb_path="$TMP_DIR/dbeaver.deb"
    curl -L -o "$deb_path" "https://dbeaver.io/files/dbeaver-ce_latest_amd64.deb"
