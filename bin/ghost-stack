    if [ "$IS_TERMUX" = true ]; then
        gem install fastlane || true
    else
        sudo gem install fastlane || true
    fi
}

# --- [03. WEB DEVELOPMENT] ---
check_nodejs() { command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; }
install_nodejs() {
    echo -e "${C_MINT}Installing Node.js LTS and npm...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install nodejs
    else
        curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -
        sudo apt install -y nodejs
    fi
}

check_pnpm_yarn() { command -v pnpm >/dev/null 2>&1 && command -v yarn >/dev/null 2>&1; }
install_pnpm_yarn() {
    echo -e "${C_MINT}Installing pnpm and yarn package managers...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        npm install -g pnpm yarn
    else
        sudo npm install -g pnpm yarn
    fi
}

check_bun() { command -v bun >/dev/null 2>&1 || [ -x "$CURRENT_HOME/.bun/bin/bun" ]; }
install_bun() {
    echo -e "${C_MINT}Installing Bun (Ultra-Fast JS Runtime & Bundler)...${C_RESET}"
    curl -fsSL https://bun.sh/install | bash
    sync_env
}

check_deno() { command -v deno >/dev/null 2>&1 || [ -x "$CURRENT_HOME/.deno/bin/deno" ]; }
install_deno() {
    echo -e "${C_MINT}Installing Deno (Secure TypeScript/JavaScript Runtime)...${C_RESET}"
    curl -fsSL https://deno.land/install.sh | sh
    sync_env
}

check_postgresql() { command -v psql >/dev/null 2>&1; }
install_postgresql() {
    echo -e "${C_MINT}Installing PostgreSQL server and client...${C_RESET}"
    pkg_install postgresql postgresql-contrib
    if [ "$IS_TERMUX" = false ]; then
        sudo systemctl enable --now postgresql || true
    fi
}

check_redis() { command -v redis-server >/dev/null 2>&1 && command -v redis-cli >/dev/null 2>&1; }
install_redis() {
    echo -e "${C_MINT}Installing Redis server and CLI...${C_RESET}"
    pkg_install redis-server redis-tools || pkg_install redis
    if [ "$IS_TERMUX" = false ]; then
        sudo systemctl enable --now redis-server || true
    fi
}

check_sqlite() { command -v sqlite3 >/dev/null 2>&1; }
install_sqlite() {
    echo -e "${C_MINT}Installing SQLite3 and development headers...${C_RESET}"
    pkg_install sqlite3 libsqlite3-dev || pkg_install sqlite
}

check_docker() { command -v docker >/dev/null 2>&1; }
install_docker() {
    echo -e "${C_MINT}Installing Docker Engine & Docker Compose...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        echo -e "${C_YELLOW}Note: Docker in Termux requires root / proot-distro environment.${C_RESET}"
        pkg_install proot-distro
    else
        pkg_install docker.io docker-compose-plugin docker-compose
        sudo systemctl enable --now docker || true
        sudo usermod -aG docker "$CURRENT_USER" || true
        echo -e "${C_LIGHT_G}Docker installed. Group activation applies on new terminal session.${C_RESET}"
    fi
}

