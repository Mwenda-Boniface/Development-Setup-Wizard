handle_help_menu() {
    while true; do
        draw_banner
        local t_cols
        t_cols=$(get_current_cols)
        if [ "$t_cols" -ge 65 ]; then
            echo -e "       ${C_WHITE}${C_BOLD}[ + ]   H E L P   &   N A V I G A T I O N   M A N U A L   [ + ]${C_RESET}\n"
            echo -e "  ${C_WHITE}[ 1 ]${C_RESET} ${C_LIGHT_G}Getting Started & Installation Guide${C_RESET}"
            echo -e "  ${C_WHITE}[ 2 ]${C_RESET} ${C_LIGHT_G}CLI Commands & Headless Automation Reference${C_RESET}"
            echo -e "  ${C_WHITE}[ 3 ]${C_RESET} ${C_LIGHT_G}Toolchain Catalog & Discipline Details${C_RESET}"
            echo -e "  ${C_WHITE}[ 4 ]${C_RESET} ${C_LIGHT_G}Troubleshooting & FAQ${C_RESET}"
        else
            echo -e "  ${C_WHITE}${C_BOLD}[+] HELP & NAVIGATION MANUAL [+]${C_RESET}\n"
            echo -e "  ${C_WHITE}[ 1 ]${C_RESET} ${C_LIGHT_G}Getting Started & Installation${C_RESET}"
            echo -e "  ${C_WHITE}[ 2 ]${C_RESET} ${C_LIGHT_G}CLI Commands & Automation${C_RESET}"
            echo -e "  ${C_WHITE}[ 3 ]${C_RESET} ${C_LIGHT_G}Toolchain Catalog & Details${C_RESET}"
            echo -e "  ${C_WHITE}[ 4 ]${C_RESET} ${C_LIGHT_G}Troubleshooting & FAQ${C_RESET}"
        fi
        echo -e "  ${C_WHITE}[ M ]${C_RESET} ${C_LIGHT_G}Return to Main Menu${C_RESET}"
        echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_GRAY}Exit Ghost-Stack${C_RESET}"
        echo ""
        echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(help) > ${C_RESET}"
        read -r h_choice || return 0

        local res=0
        case "$h_choice" in
            1) render_help_getting_started; res=$? ;;
            2) render_help_commands; res=$? ;;
            3) render_help_toolchains; res=$? ;;
            4) render_help_troubleshooting; res=$? ;;
            [mM]|main|MAIN|menu|MENU|[bB]|back|BACK) return 0 ;;
            0|[qQ]|exit|EXIT|quit|QUIT) exit 0 ;;
            *) sleep 0.3; continue ;;
        esac

        if [ "$res" -eq 10 ]; then
            return 0  # Jump to Main Menu
        elif [ "$res" -eq 20 ]; then
            exit 0    # Exit completely
        fi
    done
}

