install_insomnia() {
    echo -e "${C_MINT}Installing Insomnia REST & GraphQL Client...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        echo -e "${C_YELLOW}Notice: Insomnia GUI requires desktop environment. Skipping on Termux.${C_RESET}"
        return 0
    fi
    local deb_path="$TMP_DIR/insomnia.deb"
    curl -L -o "$deb_path" "https://updates.insomnia.rest/downloads/ubuntu/latest?&app=com.insomnia.app&source=website"
    sudo apt install -y "$deb_path" || sudo dpkg -i "$deb_path" || sudo apt install -f -y
    rm -f "$deb_path"
}

