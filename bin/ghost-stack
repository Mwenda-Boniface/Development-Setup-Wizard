    echo -e "${C_MINT}Installing Ollama (Local AI & LLM Runtime)...${C_RESET}"
    curl -fsSL https://ollama.com/install.sh | sh
}

ensure_pip() {
    if ! command -v pip3 >/dev/null 2>&1 && ! python3 -m pip --version >/dev/null 2>&1; then
        echo -e "${C_YELLOW}Bootstrapping pip and Python virtual environment tools...${C_RESET}"
        install_python_env
    fi
}

check_core_ai_stack() { python3 -c "import numpy, pandas, scipy, matplotlib" >/dev/null 2>&1; }
install_core_ai_stack() {
    ensure_pip
    echo -e "${C_MINT}Installing Core AI Stack (NumPy, Pandas, SciPy, Matplotlib, Seaborn)...${C_RESET}"
    python3 -m pip install --user --upgrade numpy pandas scipy matplotlib seaborn --break-system-packages
}

