handle_help_menu() {
    while true; do
        draw_banner
        echo -e "       ${C_WHITE}${C_BOLD}[ + ]   H E L P   &   N A V I G A T I O N   M A N U A L   [ + ]${C_RESET}\n"
        echo -e "  ${C_WHITE}[ 1 ]${C_RESET} ${C_LIGHT_G}Getting Started & Installation Guide${C_RESET}"
        echo -e "  ${C_WHITE}[ 2 ]${C_RESET} ${C_LIGHT_G}CLI Commands & Headless Automation Reference${C_RESET}"
        echo -e "  ${C_WHITE}[ 3 ]${C_RESET} ${C_LIGHT_G}Toolchain Catalog & Discipline Details${C_RESET}"
        echo -e "  ${C_WHITE}[ 4 ]${C_RESET} ${C_LIGHT_G}Troubleshooting & FAQ${C_RESET}"
        echo -e "  ${C_WHITE}[ M ]${C_RESET} ${C_LIGHT_G}Return to Main Menu${C_RESET}"
        echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_GRAY}Exit Ghost-Stack${C_RESET}"
        echo ""
        echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(help) > ${C_RESET}"
        read -r h_choice || return 0

        local res=0
        case "$h_choice" in
            1) render_help_getting_started; res=$? ;;
            2) render_help_commands; res=$? ;;
            3) render_help_toolchains; res=$? ;;
            4) render_help_troubleshooting; res=$? ;;
            [mM]|main|MAIN|menu|MENU|[bB]|back|BACK) return 0 ;;
            0|[qQ]|exit|EXIT|quit|QUIT) exit 0 ;;
            *) sleep 0.3; continue ;;
        esac

        if [ "$res" -eq 10 ]; then
            return 0  # Jump to Main Menu
        elif [ "$res" -eq 20 ]; then
            exit 0    # Exit completely
        fi
    done
}

cli_help() {
    cat << EOF
GHOST-STACK(1)                  User Commands                 GHOST-STACK(1)

NAME
    ghost-stack - Modular Development Environment & Toolchain Orchestrator

SYNOPSIS
    ghost-stack [COMMAND] [OPTIONS]
    ghost-stack                             (launches interactive TUI)

COMMANDS
    scan, -s [CATEGORY]
        Perform diagnostic scan across all categories or a specified discipline.
        Categories: android, ios, web, ai, tools, core

    install, -i <CATEGORY> [TOOLS|all]
        Perform direct headless installation of tools in a category.
        Example: ghost-stack install web 1,3
        Example: ghost-stack install ai all

    doctor, -d
        Execute Flutter Doctor and Android toolchain verification.

    install-cli
        Symlink ghost-stack into ~/.local/bin and stamp desktop launchers.

    list, -l [CATEGORY]
        Display all registered toolchains and their check functions.

    help, -h, --help [TOPIC]
        Display documentation topic (getting-started, commands, toolchains, troubleshooting).

    --version, -v
        Display ghost-stack version information.

CATEGORIES
    android     Java 21/17, cmdline-tools, platform-tools, SDK 34/36, build-tools, NDK, Gradle, Flutter, Scrcpy
    ios         usbmuxd, libimobiledevice, ideviceinstaller, ifuse, libplist, CocoaPods, Fastlane
    web         Node.js, pnpm, yarn, Bun, Deno, PostgreSQL, Redis, SQLite3, Docker, Nginx, Chrome
    ai          Python3, pip, venv, Ollama, PyTorch, Scikit-Learn, Transformers, ChromaDB, JupyterLab, HF CLI
    tools       VS Code, gh CLI, Postman, Insomnia, DBeaver, Lazygit, Git Cola, Neovim, Tmux & Htop
    core        Git Config, SSH Key, C/C++ Essentials, Rust, Go, jq/ripgrep/fzf, Network Tools

DOCUMENTATION DIRECTORY
    See full styled guides in $ROOT_DIR/help/

AUTHOR
    Mwenda Boniface (https://github.com/Mwenda-Boniface)

EOF
}

# ==============================================================================
# INTERACTIVE TUI HANDLERS
# ==============================================================================
handle_tui_category() {
    local cat_title="$1"
    local cat_array_name="$2"
    local cat_slug="$3"

    eval "local tool_list=(\"\${${cat_array_name}[@]}\")"
    local total_tools=${#tool_list[@]}

    while true; do
        draw_banner
        echo -e "       ${C_WHITE}${C_BOLD}[ + ]   $cat_title   [ + ]${C_RESET}\n"

        local installed_count=0
        local uninstalled_names=()
        local uninstalled_installers=()
        local uninstalled_checkers=()

        for idx in "${!tool_list[@]}"; do
            local item="${tool_list[$idx]}"
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            local install_fn="${rest#*|}"

            if $check_fn; then
                badge_ok "$name"
                ((installed_count++))
            else
                badge_missing "$name"
                uninstalled_names+=("$name")
                uninstalled_installers+=("$install_fn")
                uninstalled_checkers+=("$check_fn")
            fi
        done

        echo ""
        echo -e "  ${C_GRAY}─────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_WHITE}${C_BOLD}Status:${C_RESET} ${C_LIGHT_G}$installed_count${C_RESET} of ${C_WHITE}$total_tools${C_RESET} tools verified."
        echo -e "  ${C_GRAY}─────────────────────────────────────────────────────────────────${C_RESET}"

        if [ ${#uninstalled_names[@]} -eq 0 ]; then
            echo -e "\n  ${C_LIGHT_G}${C_BOLD}[ OK ] All tools in this discipline are verified and active.${C_RESET}\n"
            echo -e "  ${C_WHITE}[ R ]${C_RESET} ${C_LIGHT_G}Force reinstall / re-run a specific tool${C_RESET}"
            echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_GRAY}Return to Main Menu${C_RESET}"
            echo ""
            echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(${cat_slug}) > ${C_RESET}"
            read -r r_choice || return 0
            if [[ "$r_choice" =~ ^[Rr]$ ]]; then
                echo -ne "\n  Enter tool number to re-run (1-$total_tools): "
                read -r re_idx || continue
                if [[ "$re_idx" =~ ^[0-9]+$ ]] && [ "$re_idx" -ge 1 ] && [ "$re_idx" -le "$total_tools" ]; then
                    local target_item="${tool_list[$((re_idx-1))]}"
                    local t_rest="${target_item#*|}"
                    local t_install="${t_rest#*|}"
                    $t_install
                    pause
                fi
                continue
            else
                return 0
            fi
        fi

        echo -e "\n  ${C_WHITE}${C_BOLD}Select uninstalled tools to provision:${C_RESET}"
        echo -e "  ${C_GRAY}─────────────────────────────────────────────────────────────────${C_RESET}"
        for u_idx in "${!uninstalled_names[@]}"; do
            echo -e "  ${C_WHITE}[ $((u_idx + 1)) ]${C_RESET} ${C_LIGHT_G}${uninstalled_names[$u_idx]}${C_RESET}"
        done
        echo -e "  ${C_WHITE}[ A ]${C_RESET} ${C_LIGHT_G}Install ALL uninstalled tools listed above${C_RESET}"
        echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_GRAY}Return to Main Menu${C_RESET}"
        echo -e "  ${C_GRAY}─────────────────────────────────────────────────────────────────${C_RESET}"
        echo ""
        echo -e "  ${C_GRAY}Enter numbers separated by commas (e.g. 1,2 or 1,3 or 'A' or '0'):${C_RESET}"
        echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack(${cat_slug}) > ${C_RESET}"
        read -r user_selection || return 0

        if [[ "$user_selection" =~ ^[0bBqQ]$ ]] || [[ "$user_selection" =~ ^(back|exit|quit|menu)$ ]]; then
            return 0
        fi

        if [[ "$user_selection" =~ ^[Aa]$ ]]; then
            echo -e "\n${C_LIGHT_G}==> Provisioning all ${#uninstalled_names[@]} missing tools...${C_RESET}\n"
            local success_count=0
            local fail_count=0
            for u_idx in "${!uninstalled_names[@]}"; do
                echo -e "\n${C_DARK_G}>>> [ $((u_idx+1)) / ${#uninstalled_names[@]} ] Installing: ${C_WHITE}${uninstalled_names[$u_idx]}${C_RESET}"
                ${uninstalled_installers[$u_idx]}
                sync_env
                if ${uninstalled_checkers[$u_idx]}; then
                    echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ] Verified:${C_RESET} ${C_WHITE}${uninstalled_names[$u_idx]}${C_RESET} is active and verified."
                    ((success_count++))
                else
                    echo -e "  ${C_RED}${C_BOLD}[ FAILED ] Verification error:${C_RESET} ${C_YELLOW}${uninstalled_names[$u_idx]}${C_RESET} failed check after installation."
                    ((fail_count++))
                fi
            done
            sync_env
            persist_env
            auto_stamp_desktop
            if [ "$fail_count" -eq 0 ]; then
                echo -e "\n${C_LIGHT_G}${C_BOLD}[ OK ] Batch provisioning completed. All $success_count tools verified successfully.${C_RESET}"
            else
                echo -e "\n${C_YELLOW}${C_BOLD}[ ATTENTION ] Batch provisioning completed with issues: $success_count verified, $fail_count failed.${C_RESET}"
            fi
            pause
            continue
        fi

        IFS=',' read -ra SELECTED_ITEMS <<< "$user_selection"
        local success_count=0
        local fail_count=0
        for sel in "${SELECTED_ITEMS[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#uninstalled_names[@]}" ]; then
                local t_idx=$((sel - 1))
                echo -e "\n${C_DARK_G}>>> Installing: ${C_WHITE}${uninstalled_names[$t_idx]}${C_RESET}"
                ${uninstalled_installers[$t_idx]}
                sync_env
                if ${uninstalled_checkers[$t_idx]}; then
                    echo -e "  ${C_LIGHT_G}${C_BOLD}[ OK ] Verified:${C_RESET} ${C_WHITE}${uninstalled_names[$t_idx]}${C_RESET} is active and verified."
                    ((success_count++))
                else
                    echo -e "  ${C_RED}${C_BOLD}[ FAILED ] Verification error:${C_RESET} ${C_YELLOW}${uninstalled_names[$t_idx]}${C_RESET} failed check after installation."
                    ((fail_count++))
                fi
            else
                echo -e "${C_RED}Skipping invalid selection index: $sel${C_RESET}"
            fi
        done

        if [ $((success_count + fail_count)) -gt 0 ]; then
            sync_env
            persist_env
            auto_stamp_desktop
            if [ "$fail_count" -eq 0 ]; then
                echo -e "\n${C_LIGHT_G}${C_BOLD}[ OK ] Provisioning complete. All $success_count tools verified successfully.${C_RESET}"
            else
                echo -e "\n${C_YELLOW}${C_BOLD}[ ATTENTION ] Completed with issues: $success_count verified, $fail_count failed.${C_RESET}"
            fi
            pause
        fi
    done
}

G_WINCH_TRIGGERED=false
handle_winch() {
    G_WINCH_TRIGGERED=true
}
trap 'handle_winch' WINCH

tui_main() {
    while true; do
        draw_banner
        draw_home_telemetry
        echo -e "  ${C_WHITE}[ 1 ]${C_RESET} ${C_LIGHT_G}Android Development${C_RESET}"
        echo -e "  ${C_WHITE}[ 2 ]${C_RESET} ${C_LIGHT_G}iOS Development (Linux Stack)${C_RESET}"
        echo -e "  ${C_WHITE}[ 3 ]${C_RESET} ${C_LIGHT_G}Web Development${C_RESET}"
        echo -e "  ${C_WHITE}[ 4 ]${C_RESET} ${C_LIGHT_G}AI & Machine Learning${C_RESET}"
        echo -e "  ${C_WHITE}[ 5 ]${C_RESET} ${C_LIGHT_G}Development Softwares & IDEs${C_RESET}"
        echo -e "  ${C_WHITE}[ 6 ]${C_RESET} ${C_LIGHT_G}Core System Tools & DevOps${C_RESET}"
        echo -e "  ${C_WHITE}[ S ]${C_RESET} ${C_LIGHT_G}Full Diagnostic Scan${C_RESET}"
        echo -e "  ${C_WHITE}[ D ]${C_RESET} ${C_LIGHT_G}Flutter & Android Doctor${C_RESET}"
        echo -e "  ${C_WHITE}[ H ]${C_RESET} ${C_LIGHT_G}Help & Navigation Manual${C_RESET}"
        echo -e "  ${C_WHITE}[ R ]${C_RESET} ${C_LIGHT_G}Refresh Screen${C_RESET}"
        echo -e "  ${C_WHITE}[ 0 ]${C_RESET} ${C_LIGHT_G}Exit${C_RESET}"
        echo ""
        echo -ne "  ${C_LIGHT_G}${C_BOLD}ghost-stack > ${C_RESET}"
        read -r choice || choice=""

        if [ "$G_WINCH_TRIGGERED" = true ]; then
            G_WINCH_TRIGGERED=false
            continue
        fi

        case "$choice" in
            [rR]|"") continue ;;
            1|01) handle_tui_category "ANDROID DEVELOPMENT" "TOOLS_ANDROID" "android" ;;
            2|02) handle_tui_category "IOS DEVELOPMENT (LINUX STACK)" "TOOLS_IOS" "ios" ;;
            3|03) handle_tui_category "WEB DEVELOPMENT" "TOOLS_WEB" "web" ;;
            4|04) handle_tui_category "AI & MACHINE LEARNING" "TOOLS_AI" "ai" ;;
            5|05) handle_tui_category "DEVELOPMENT SOFTWARES & IDES" "TOOLS_SOFTWARE" "tools" ;;
            6|06) handle_tui_category "CORE SYSTEM TOOLS & DEVOPS" "TOOLS_CORE" "core" ;;
            [sS]) cli_scan ""; pause ;;
            [dD]) cli_doctor; pause ;;
            [hH]) handle_help_menu ;;
            0|[qQ])
                echo -e "\n${C_LIGHT_G}Exiting Ghost-Stack. Happy coding.${C_RESET}\n"
                exit 0
                ;;
            *)
                echo -e "\n${C_RED}Invalid option.${C_RESET}"
                sleep 0.5
                ;;
        esac
    done
}

# ==============================================================================
# CLI DISPATCH ROUTER
# ==============================================================================
case "$1" in
    scan|-s|--scan)
        cli_scan "$2"
        ;;
    install|-i|--install)
        cli_install "$2" "$3"
        ;;
    doctor|-d|--doctor)
        cli_doctor
        ;;
    install-cli|--install-cli)
        cli_install_binary
        ;;
    list|-l|--list)
        cli_scan "$2"
        ;;
    help|-h|--help)
        if [ -n "$2" ]; then
            case "$2" in
                getting-started|start|01) render_help_getting_started ;;
                commands|cli|02)          render_help_commands ;;
                toolchains|tools|03)      render_help_toolchains ;;
                troubleshooting|faq|04)   render_help_troubleshooting ;;
                *) cli_help ;;
            esac
        else
            cli_help
        fi
        exit 0
        ;;
    --version|-v)
        echo "ghost-stack version 3.1.0 ($ARCH-$OS_NAME)"
        exit 0
        ;;
    "")
        tui_main
        ;;
    *)
        echo -e "${C_RED}Unknown command: $1${C_RESET}"
        echo "Use 'ghost-stack --help' for usage instructions."
        exit 1
        ;;
esac
