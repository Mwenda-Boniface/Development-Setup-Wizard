}

check_lazygit() { command -v lazygit >/dev/null 2>&1; }
install_lazygit() {
    echo -e "${C_MINT}Installing Lazygit (Terminal UI for Git)...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install lazygit
    else
        local lg_ver
        lg_ver=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        if [ -n "$lg_ver" ]; then
            curl -Lo "$TMP_DIR/lazygit.tar.gz" "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${lg_ver}_Linux_x86_64.tar.gz"
            sudo tar -xf "$TMP_DIR/lazygit.tar.gz" -C /usr/local/bin lazygit
            rm -f "$TMP_DIR/lazygit.tar.gz"
        else
            pkg_install lazygit || true
        fi
    fi
}

check_git_gui() { command -v git-cola >/dev/null 2>&1 || command -v gitk >/dev/null 2>&1; }
install_git_gui() {
    echo -e "${C_MINT}Installing Git GUI Tools (Git Cola, Gitk)...${C_RESET}"
    pkg_install git-cola gitk
}

check_neovim() { command -v nvim >/dev/null 2>&1; }
install_neovim() {
    echo -e "${C_MINT}Installing Neovim (Modern Extensible Terminal Editor)...${C_RESET}"
    pkg_install neovim
}

check_tmux_htop() { command -v tmux >/dev/null 2>&1 && command -v htop >/dev/null 2>&1; }
install_tmux_htop() {
    echo -e "${C_MINT}Installing Tmux and Htop...${C_RESET}"
    pkg_install tmux htop
}

# --- [06. CORE SYSTEM & DEVOPS / SECURITY] ---
check_git_configured() { command -v git >/dev/null 2>&1 && [ -n "$(git config --global user.name 2>/dev/null)" ]; }
install_git_configured() {
    echo -e "${C_MINT}Configuring Git Global Identity...${C_RESET}"
    read -rp "Enter Full Name: " g_name
    read -rp "Enter GitHub Email: " g_email
    [ -n "$g_name" ] && git config --global user.name "$g_name"
    [ -n "$g_email" ] && git config --global user.email "$g_email"
    git config --global init.defaultBranch main
}

check_github_ssh() { [ -f "$CURRENT_HOME/.ssh/id_ed25519" ]; }
install_github_ssh() {
    echo -e "${C_MINT}Generating Ed25519 SSH Key for GitHub...${C_RESET}"
    local email
    email=$(git config --global user.email 2>/dev/null || echo "developer@example.com")
    mkdir -p "$CURRENT_HOME/.ssh" && chmod 700 "$CURRENT_HOME/.ssh"
    ssh-keygen -t ed25519 -C "$email" -f "$CURRENT_HOME/.ssh/id_ed25519" -N ""
    chmod 600 "$CURRENT_HOME/.ssh/id_ed25519"
    chmod 644 "$CURRENT_HOME/.ssh/id_ed25519.pub"
    echo -e "\n${C_LIGHT_G}Public Key (Copy to https://github.com/settings/keys):${C_RESET}"
    cat "$CURRENT_HOME/.ssh/id_ed25519.pub"
    echo ""
    read -rp "Press [Enter] to test connection..."
    ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -T git@github.com 2>&1 || true
}

check_build_essentials() {
    command -v gcc >/dev/null 2>&1 && command -v clang >/dev/null 2>&1 && command -v cmake >/dev/null 2>&1 && command -v ninja >/dev/null 2>&1
}
install_build_essentials() {
    echo -e "${C_MINT}Installing C/C++ Build Essentials and system headers...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install build-essential clang cmake ninja pkg-config git curl unzip zip
    else
        pkg_install build-essential gcc g++ clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev mesa-utils curl git unzip zip xz-utils
    fi
}

check_rust() { command -v rustc >/dev/null 2>&1 && command -v cargo >/dev/null 2>&1; }
install_rust() {
    echo -e "${C_MINT}Installing Rust Toolchain (rustup, rustc, cargo)...${C_RESET}"
    if [ "$IS_TERMUX" = true ]; then
        pkg_install rust
    else
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    fi
    sync_env
}

check_golang() { command -v go >/dev/null 2>&1; }
install_golang() {
    echo -e "${C_MINT}Installing Go Programming Language (golang)...${C_RESET}"
    pkg_install golang-go || pkg_install golang
    sync_env
}

check_cli_utils() { command -v jq >/dev/null 2>&1 && command -v rg >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; }
install_cli_utils() {
    echo -e "${C_MINT}Installing Modern Developer Utilities (jq, ripgrep, fzf)...${C_RESET}"
    pkg_install jq ripgrep fzf
}

check_net_tools() { command -v nmap >/dev/null 2>&1 && command -v nc >/dev/null 2>&1; }
install_net_tools() {
    echo -e "${C_MINT}Installing Network Diagnostic & Security Utilities (nmap, netcat, tcpdump)...${C_RESET}"
    pkg_install nmap netcat-openbsd tcpdump || pkg_install nmap netcat tcpdump
}

