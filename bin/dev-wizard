)

TOOLS_CORE=(
    "Git CLI & Global Identity Setup|check_git_configured|install_git_configured"
    "GitHub SSH Authentication Key (~/.ssh/id_ed25519)|check_github_ssh|install_github_ssh"
    "C/C++ Build Essentials (clang, cmake, ninja)|check_build_essentials|install_build_essentials"
)

get_category_array_name() {
    case "$1" in
        android|1) echo "TOOLS_ANDROID" ;;
        ios|2)     echo "TOOLS_IOS" ;;
        web|3)     echo "TOOLS_WEB" ;;
        ai|4)      echo "TOOLS_AI" ;;
        software|tools|5) echo "TOOLS_SOFTWARE" ;;
        core|git|6) echo "TOOLS_CORE" ;;
        *) return 1 ;;
    esac
}

get_category_title() {
    case "$1" in
        android|1) echo "ANDROID DEVELOPMENT" ;;
        ios|2)     echo "IOS DEVELOPMENT (LINUX TOOLS)" ;;
        web|3)     echo "WEB DEVELOPMENT" ;;
        ai|4)      echo "AI & MACHINE LEARNING DEVELOPMENT" ;;
        software|tools|5) echo "DEVELOPMENT SOFTWARES & TOOLS" ;;
        core|git|6) echo "CORE SYSTEM TOOLS & GIT" ;;
        *) echo "UNKNOWN CATEGORY" ;;
    esac
}

# ==============================================================================
# CLI EXECUTION MODES FOR TECH GURUS
# ==============================================================================

# CLI: Diagnostic scan
cli_scan() {
    local target_cat="$1"

    if [ -n "$target_cat" ]; then
        local arr_name
        arr_name=$(get_category_array_name "$target_cat") || {
            echo -e "${C_RED}Error: Unknown category '$target_cat'.${C_RESET}"
            echo "Available categories: android, ios, web, ai, tools, core"
            exit 1
        }
        local title
        title=$(get_category_title "$target_cat")
        echo -e "${C_DARK_G}┌─[ ${C_EMERALD}${C_BOLD}DIAGNOSTIC SCAN: $title${C_RESET}${C_DARK_G} ]${C_RESET}"
        eval "local tools=(\"\${${arr_name}[@]}\")"
        local missing=0
        for item in "${tools[@]}"; do
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            if $check_fn; then
                badge_ok "$name"
            else
                badge_missing "$name"
                ((missing++))
            fi
        done
        echo -e "${C_DARK_G}└─────────────────────────────────────────────────────────${C_RESET}"
        [ "$missing" -eq 0 ] && exit 0 || exit 1
    fi

    echo -e "${C_DARK_G}╔═══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_DARK_G}║${C_RESET}  ${C_EMERALD}${C_BOLD}COMPREHENSIVE TOOLCHAIN DIAGNOSTIC SCAN${C_RESET}                                   ${C_DARK_G}║${C_RESET}"
    echo -e "${C_DARK_G}╚═══════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo ""

    local categories=("TOOLS_ANDROID" "TOOLS_IOS" "TOOLS_WEB" "TOOLS_AI" "TOOLS_SOFTWARE" "TOOLS_CORE")
    local titles=("ANDROID DEVELOPMENT" "IOS DEVELOPMENT (LINUX TOOLS)" "WEB DEVELOPMENT" "AI & MACHINE LEARNING" "DEVELOPMENT SOFTWARES" "CORE SYSTEM TOOLS & GIT")

    local total_checked=0
    local total_passed=0

    for idx in "${!categories[@]}"; do
        echo -e "${C_DARK_G}┌─[ ${C_MINT}${C_BOLD}${titles[$idx]}${C_RESET}${C_DARK_G} ]${C_RESET}"
        eval "local tools=(\"\${${categories[$idx]}[@]}\")"
        for item in "${tools[@]}"; do
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            ((total_checked++))
            if $check_fn; then
                badge_ok "$name"
                ((total_passed++))
            else
                badge_missing "$name"
            fi
        done
        echo -e "${C_DARK_G}└─────────────────────────────────────────────────────────${C_RESET}\n"
    done

    echo -e "${C_WHITE}${C_BOLD}Scan Summary:${C_RESET} ${C_EMERALD}$total_passed${C_RESET} of ${C_WHITE}$total_checked${C_RESET} tools verified."
    if [ "$total_passed" -eq "$total_checked" ]; then
        echo -e "${C_EMERALD}${C_BOLD}Status: All required developer tools are installed!${C_RESET}"
        exit 0
    else
        echo -e "${C_YELLOW}${C_BOLD}Status: Missing tools detected. Run 'dev-wizard' or 'dev-wizard install <cat> <items>' to install.${C_RESET}"
        exit 1
    fi
}

# CLI: Headless installation
cli_install() {
    local cat_input="$1"
    local tools_input="$2"

    if [ -z "$cat_input" ]; then
        echo -e "${C_RED}Error: Category required. Example: dev-wizard install web 1,3 or dev-wizard install ai all${C_RESET}"
        exit 1
    fi

    local arr_name
    arr_name=$(get_category_array_name "$cat_input") || {
        echo -e "${C_RED}Error: Unknown category '$cat_input'.${C_RESET}"
        echo "Valid categories: android, ios, web, ai, tools, core"
        exit 1
    }

    eval "local tools=(\"\${${arr_name}[@]}\")"
    local uninstalled_names=()
    local uninstalled_installers=()

    for item in "${tools[@]}"; do
        local name="${item%%|*}"
        local rest="${item#*|}"
        local check_fn="${rest%%|*}"
        local install_fn="${rest#*|}"
        if ! $check_fn; then
            uninstalled_names+=("$name")
            uninstalled_installers+=("$install_fn")
        fi
    done

    if [ ${#uninstalled_names[@]} -eq 0 ]; then
        echo -e "${C_EMERALD}[OK] All tools in category '$cat_input' are already installed.${C_RESET}"
        exit 0
    fi

    if [ -z "$tools_input" ]; then
        echo -e "${C_YELLOW}Missing tools in category '$cat_input':${C_RESET}"
        for i in "${!uninstalled_names[@]}"; do
            echo -e "  [$((i+1))] ${uninstalled_names[$i]}"
        done
        echo ""
        echo "Run with selection, e.g.: dev-wizard install $cat_input 1,2 or dev-wizard install $cat_input all"
        exit 0
    fi

    if [ "$tools_input" = "all" ] || [ "$tools_input" = "ALL" ]; then
        echo -e "${C_MINT}Installing all missing tools in category '$cat_input'...${C_RESET}"
        for i in "${!uninstalled_installers[@]}"; do
            echo -e "\n${C_DARK_G}>>> [ $((i+1)) / ${#uninstalled_installers[@]} ] Installing: ${uninstalled_names[$i]}${C_RESET}"
            ${uninstalled_installers[$i]}
        done
    else
        IFS=',' read -ra SELECTED <<< "$tools_input"
        for sel in "${SELECTED[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#uninstalled_names[@]}" ]; then
                local idx=$((sel - 1))
                echo -e "\n${C_DARK_G}>>> Installing: ${uninstalled_names[$idx]}${C_RESET}"
                ${uninstalled_installers[$idx]}
            else
                echo -e "${C_RED}Skipping invalid selection index: $sel${C_RESET}"
            fi
        done
    fi

    sync_env
    persist_env
    echo -e "\n${C_EMERALD}${C_BOLD}[OK] Batch installation completed.${C_RESET}"
}

# CLI: Install CLI binary into ~/.local/bin
cli_install_binary() {
    mkdir -p "$HOME/.local/bin"
    ln -sf "$REAL_SCRIPT_PATH" "$HOME/.local/bin/dev-wizard"
    chmod +x "$HOME/.local/bin/dev-wizard"
    persist_env
    echo -e "${C_EMERALD}${C_BOLD}[OK] 'dev-wizard' has been installed to $HOME/.local/bin/dev-wizard${C_RESET}"
    echo -e "You can now run ${C_WHITE}${C_BOLD}dev-wizard${C_RESET} directly from any terminal directory!"
}

# CLI: Doctor
cli_doctor() {
    sync_env
    echo -e "${C_DARK_G}╔═══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_DARK_G}║${C_RESET}  ${C_EMERALD}${C_BOLD}FLUTTER & ANDROID TOOLCHAIN DOCTOR${C_RESET}                                      ${C_DARK_G}║${C_RESET}"
    echo -e "${C_DARK_G}╚═══════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo ""
    if command -v flutter >/dev/null 2>&1; then
        flutter doctor -v
    elif [ -x "$FLUTTER_DIR/bin/flutter" ]; then
        "$FLUTTER_DIR/bin/flutter" doctor -v
    else
        echo -e "${C_RED}Flutter binary not found. Install it via 'dev-wizard install android 6'.${C_RESET}"
        exit 1
    fi
}

# CLI: Help page
cli_help() {
    cat << EOF
DEV-WIZARD(1)                   User Commands                  DEV-WIZARD(1)

NAME
    dev-wizard - Modular Development Environment & Toolchain Orchestrator

SYNOPSIS
    dev-wizard [COMMAND] [OPTIONS]
    dev-wizard                              (launches interactive TUI)

COMMANDS
    scan, -s [CATEGORY]
        Perform diagnostic scan across all categories or a specified discipline.
        Categories: android, ios, web, ai, tools, core

    install, -i <CATEGORY> [TOOLS|all]
        Perform direct headless installation of tools in a category.
        Example: dev-wizard install web 1,3
        Example: dev-wizard install ai all

    doctor, -d
        Execute Flutter Doctor and Android toolchain verification.

    install-cli
        Symlink dev-wizard into ~/.local/bin for global system access.

    list, -l [CATEGORY]
        Display all registered toolchains and their check functions.

    --help, -h
        Display this manual page.

    --version, -v
        Display dev-wizard version information.

CATEGORIES
    android     Java 21, cmdline-tools, platform-tools, SDK 34/36, build-tools, Flutter
    ios         usbmuxd, libimobiledevice, ideviceinstaller, CocoaPods
    web         Node.js, pnpm, yarn, PostgreSQL, Redis, Docker, Chrome
    ai          Python3, pip, venv, Ollama, PyTorch, JupyterLab, Hugging Face
    tools       VS Code, gh CLI, Postman, DBeaver, Git Cola, Tmux & Htop
    core        Git Config, GitHub SSH Key (~/.ssh/id_ed25519), C/C++ Build Essentials

EXAMPLES
    dev-wizard
    dev-wizard scan
    dev-wizard scan web
    dev-wizard install web 1,2
    dev-wizard install ai all
    dev-wizard doctor

AUTHOR
    Mwenda Boniface (https://github.com/Mwenda-Boniface)

EOF
}

# ==============================================================================
# INTERACTIVE TUI HANDLERS
# ==============================================================================
handle_tui_category() {
    local cat_title="$1"
    local cat_array_name="$2"

    eval "local tool_list=(\"\${${cat_array_name}[@]}\")"
    local total_tools=${#tool_list[@]}

    while true; do
        draw_banner
        echo -e "${C_DARK_G}┌─[ ${C_EMERALD}${C_BOLD}DISCIPLINE: $cat_title${C_RESET}${C_DARK_G} ]${C_RESET}"
        echo -e "${C_DARK_G}│${C_RESET} ${C_GRAY}Scanning toolchain state...${C_RESET}"
        echo -e "${C_DARK_G}│${C_RESET}"

        local installed_count=0
        local uninstalled_names=()
        local uninstalled_installers=()

        for idx in "${!tool_list[@]}"; do
            local item="${tool_list[$idx]}"
            local name="${item%%|*}"
            local rest="${item#*|}"
            local check_fn="${rest%%|*}"
            local install_fn="${rest#*|}"

            if $check_fn; then
                badge_ok "$name"
                ((installed_count++))
            else
                badge_missing "$name"
                uninstalled_names+=("$name")
                uninstalled_installers+=("$install_fn")
            fi
        done

        echo -e "${C_DARK_G}├───────────────────────────────────────────────────────────────────────────┤${C_RESET}"
        echo -e "${C_DARK_G}│${C_RESET}  ${C_BOLD}Status:${C_RESET} ${C_EMERALD}$installed_count${C_RESET} of ${C_WHITE}$total_tools${C_RESET} tools verified."
        echo -e "${C_DARK_G}└───────────────────────────────────────────────────────────────────────────┘${C_RESET}"

        if [ ${#uninstalled_names[@]} -eq 0 ]; then
            echo -e "\n  ${C_EMERALD}${C_BOLD}[OK] All tools in this discipline are verified and active.${C_RESET}\n"
            echo -e "  ${C_WHITE}[R]${C_RESET} Force reinstall / re-run a specific tool"
            echo -e "  ${C_WHITE}[0]${C_RESET} Return to Main Menu"
            echo ""
            echo -n "  Select option: "
            read -r r_choice || return 0
            if [[ "$r_choice" =~ ^[Rr]$ ]]; then
                echo -e "\n  Enter tool number to re-run (1-$total_tools): "
                read -r re_idx || continue
                if [[ "$re_idx" =~ ^[0-9]+$ ]] && [ "$re_idx" -ge 1 ] && [ "$re_idx" -le "$total_tools" ]; then
                    local target_item="${tool_list[$((re_idx-1))]}"
                    local t_rest="${target_item#*|}"
                    local t_install="${t_rest#*|}"
                    $t_install
                    pause
                fi
                continue
            else
                return 0
            fi
        fi

        echo -e "\n  ${C_WHITE}${C_BOLD}Select uninstalled tools to provision:${C_RESET}"
        echo -e "  ${C_DARK_G}─────────────────────────────────────────────────────────────────────────${C_RESET}"
        for u_idx in "${!uninstalled_names[@]}"; do
            echo -e "  ${C_MINT}[ $((u_idx + 1)) ]${C_RESET} ${C_BOLD}${uninstalled_names[$u_idx]}${C_RESET}"
        done
        echo -e "  ${C_EMERALD}[ A ]${C_RESET} ${C_BOLD}Install ALL uninstalled tools listed above${C_RESET}"
        echo -e "  ${C_GRAY}[ 0 ] Return to Main Menu${C_RESET}"
        echo -e "  ${C_DARK_G}─────────────────────────────────────────────────────────────────────────${C_RESET}"
        echo ""
        echo -e "  ${C_GRAY}Enter numbers separated by commas (e.g. 1,2 or 1,3 or 'A' or '0'):${C_RESET}"
        echo -n "  >>> "
        read -r user_selection || return 0

        if [[ "$user_selection" =~ ^[0bBqQ]$ ]]; then
            return 0
        fi

        if [[ "$user_selection" =~ ^[Aa]$ ]]; then
            echo -e "\n${C_EMERALD}==> Provisioning all ${#uninstalled_names[@]} missing tools...${C_RESET}\n"
            for u_idx in "${!uninstalled_names[@]}"; do
                echo -e "\n${C_DARK_G}┌─[ ${C_WHITE}Installing ($((u_idx+1))/${#uninstalled_names[@]}): ${uninstalled_names[$u_idx]}${C_RESET}${C_DARK_G} ]${C_RESET}"
                ${uninstalled_installers[$u_idx]}
            done
            sync_env
            persist_env
            echo -e "\n${C_EMERALD}${C_BOLD}[OK] Batch provisioning completed successfully.${C_RESET}"
            pause
            continue
        fi

        IFS=',' read -ra SELECTED_ITEMS <<< "$user_selection"
        local count=0
        for sel in "${SELECTED_ITEMS[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#uninstalled_names[@]}" ]; then
                local t_idx=$((sel - 1))
                echo -e "\n${C_DARK_G}┌─[ ${C_WHITE}Installing: ${uninstalled_names[$t_idx]}${C_RESET}${C_DARK_G} ]${C_RESET}"
                ${uninstalled_installers[$t_idx]}
                ((count++))
            else
                echo -e "${C_RED}Skipping invalid selection index: $sel${C_RESET}"
            fi
        done

        if [ "$count" -gt 0 ]; then
            sync_env
            persist_env
            echo -e "\n${C_EMERALD}${C_BOLD}[OK] Provisioning complete.${C_RESET}"
            pause
        fi
    done
}

# ==============================================================================
# MAIN INTERACTIVE TUI LOOP
# ==============================================================================
tui_main() {
    while true; do
        draw_banner
        echo -e "  ${C_WHITE}${C_BOLD}Select a toolchain discipline to inspect or provision:${C_RESET}"
        echo ""
        echo -e "  ${C_EMERALD}[ 01 ]${C_RESET} ${C_BOLD}Android Development${C_RESET}"
        echo -e "         ${C_GRAY}Flutter, Java 21, cmdline-tools, platform SDKs 34/36, build-tools${C_RESET}"
        echo ""
        echo -e "  ${C_EMERALD}[ 02 ]${C_RESET} ${C_BOLD}iOS Development (Linux Compatibility Stack)${C_RESET}"
        echo -e "         ${C_GRAY}usbmuxd, libimobiledevice, ideviceinstaller, CocoaPods${C_RESET}"
        echo ""
        echo -e "  ${C_EMERALD}[ 03 ]${C_RESET} ${C_BOLD}Web Development${C_RESET}"
        echo -e "         ${C_GRAY}Node.js, npm, pnpm, yarn, PostgreSQL, Redis, Docker, Chrome${C_RESET}"
        echo ""
        echo -e "  ${C_EMERALD}[ 04 ]${C_RESET} ${C_BOLD}AI & Machine Learning Development${C_RESET}"
        echo -e "         ${C_GRAY}Python 3, Ollama (Local LLMs), PyTorch, NumPy, JupyterLab, Hugging Face${C_RESET}"
        echo ""
        echo -e "  ${C_EMERALD}[ 05 ]${C_RESET} ${C_BOLD}Development Softwares & IDEs${C_RESET}"
        echo -e "         ${C_GRAY}VS Code, GitHub CLI (gh), Postman, DBeaver, Git Cola, Tmux & Htop${C_RESET}"
        echo ""
        echo -e "  ${C_EMERALD}[ 06 ]${C_RESET} ${C_BOLD}Core System Tools & Git / GitHub${C_RESET}"
        echo -e "         ${C_GRAY}Git Identity, GitHub SSH Key (~/.ssh/id_ed25519), C/C++ Build Essentials${C_RESET}"
        echo ""
        echo -e "  ${C_DARK_G}─────────────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_WHITE}[ S ]${C_RESET} ${C_BOLD}Run Full System Diagnostic Scan (All Categories)${C_RESET}"
        echo -e "  ${C_WHITE}[ D ]${C_RESET} ${C_BOLD}Run Flutter Doctor Diagnostic${C_RESET}"
        echo -e "  ${C_WHITE}[ C ]${C_RESET} ${C_BOLD}Install 'dev-wizard' to ~/.local/bin (Global CLI Access)${C_RESET}"
        echo -e "  ${C_GRAY}[ 0 ] Exit${C_RESET}"
        echo -e "  ${C_DARK_G}─────────────────────────────────────────────────────────────────────────${C_RESET}"
        echo ""
        echo -n "  Enter choice [1-6, S, D, C, 0]: "
        read -r choice || exit 0

        case "$choice" in
            1|01) handle_tui_category "ANDROID DEVELOPMENT" "TOOLS_ANDROID" ;;
            2|02) handle_tui_category "IOS DEVELOPMENT (LINUX TOOLS)" "TOOLS_IOS" ;;
            3|03) handle_tui_category "WEB DEVELOPMENT" "TOOLS_WEB" ;;
            4|04) handle_tui_category "AI & MACHINE LEARNING" "TOOLS_AI" ;;
            5|05) handle_tui_category "DEVELOPMENT SOFTWARES" "TOOLS_SOFTWARE" ;;
            6|06) handle_tui_category "CORE SYSTEM TOOLS & GIT" "TOOLS_CORE" ;;
            [sS]) cli_scan "" ;;
            [dD]) cli_doctor ;;
            [cC]) cli_install_binary; pause ;;
            0|[qQ])
                echo -e "\n${C_EMERALD}Exiting dev-wizard. Happy coding.${C_RESET}\n"
                exit 0
                ;;
            *)
                echo -e "\n${C_RED}Invalid option.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ==============================================================================
# CLI DISPATCH ROUTER
# ==============================================================================
case "$1" in
    scan|-s|--scan)
        cli_scan "$2"
        ;;
    install|-i|--install)
        cli_install "$2" "$3"
        ;;
    doctor|-d|--doctor)
        cli_doctor
        ;;
    install-cli|--install-cli)
        cli_install_binary
        ;;
    list|-l|--list)
        cli_scan "$2"
        ;;
    --version|-v)
        echo "dev-wizard version 2.1.0 (x86_64-linux-gnu)"
        exit 0
        ;;
    --help|-h|help)
        cli_help
        exit 0
        ;;
    "")
        tui_main
        ;;
    *)
        echo -e "${C_RED}Unknown command: $1${C_RESET}"
        echo "Use 'dev-wizard --help' for usage instructions."
        exit 1
        ;;
esac
