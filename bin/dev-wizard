#!/usr/bin/env bash
# ==============================================================================
# DEV-WIZARD CLI & TUI TOOLCHAIN ORCHESTRATOR
# Version: 2.1.0
# License: MIT
# Platform: Linux (Debian, Ubuntu, Kali, Mint, Pop!_OS)
# Style: Minimalist Terminal Emerald Green (Strictly Zero Emojis)
# ==============================================================================

set -o pipefail

# Ensure bash execution
if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

# Core Paths
REAL_SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$REAL_SCRIPT_PATH")/.." && pwd)"
DEV_DIR="$HOME/development"
FLUTTER_DIR="$DEV_DIR/flutter"
ANDROID_DIR="$HOME/Android/Sdk"
JAVA_PREFERRED_PATH="/usr/lib/jvm/java-21-openjdk-amd64"

# ==============================================================================
# COLOR PALETTE (EMERALD GREEN THEME)
# ==============================================================================
C_EMERALD="\033[38;5;48m"   # Bright glowing emerald
C_MINT="\033[38;5;84m"      # Crisp readable mint green
C_FOREST="\033[38;5;35m"    # Mid forest green
C_DARK_G="\033[38;5;29m"    # Deep border green
C_WHITE="\033[1;37m"        # High contrast white
C_GRAY="\033[38;5;244m"     # Technical muted gray
C_RED="\033[1;31m"          # Failure / missing
C_YELLOW="\033[1;33m"       # Warning / attention
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

# Status Badges (Strictly Zero Emojis)
badge_ok()      { echo -e "  ${C_EMERALD}${C_BOLD}[ OK ]${C_RESET}       $1"; }
badge_missing() { echo -e "  ${C_RED}${C_BOLD}[ MISSING ]${C_RESET}  $1"; }
badge_warn()    { echo -e "  ${C_YELLOW}${C_BOLD}[ WARN ]${C_RESET}     $1"; }
badge_info()    { echo -e "  ${C_MINT}${C_BOLD}[ INFO ]${C_RESET}     $1"; }

# ==============================================================================
# ENVIRONMENT SYNCHRONIZATION
# ==============================================================================
sync_env() {
    if [ -d "$JAVA_PREFERRED_PATH" ]; then
        export JAVA_HOME="$JAVA_PREFERRED_PATH"
    fi
    export ANDROID_HOME="$ANDROID_DIR"
    export PATH="$HOME/.local/bin:$FLUTTER_DIR/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:${JAVA_HOME:-/usr}/bin:$PATH"
}
sync_env

persist_env() {
    local env_block="
# --- DEV-WIZARD ENVIRONMENT PATHS ---
export JAVA_HOME=\"${JAVA_PREFERRED_PATH}\"
export ANDROID_HOME=\"\$HOME/Android/Sdk\"
export PATH=\"\$HOME/.local/bin:\$HOME/development/flutter/bin:\$ANDROID_HOME/cmdline-tools/latest/bin:\$ANDROID_HOME/platform-tools:\$JAVA_HOME/bin:\$PATH\"
# ------------------------------------"

    for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        if [ -f "$rc" ]; then
            if ! grep -q "DEV-WIZARD ENVIRONMENT PATHS" "$rc" && ! grep -q "ANDROID_HOME" "$rc"; then
                echo "$env_block" >> "$rc"
            fi
        fi
    done
}
persist_env

# ==============================================================================
# UI RENDERERS
# ==============================================================================
draw_banner() {
    clear
    echo -e "${C_DARK_G}╔═══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_DARK_G}║${C_RESET}  ${C_EMERALD}${C_BOLD}DEV-WIZARD // SYSTEM & TOOLCHAIN ORCHESTRATOR${C_RESET}                ${C_DARK_G}v2.1.0${C_RESET}  ${C_DARK_G}║${C_RESET}"
    echo -e "${C_DARK_G}║${C_RESET}  ${C_GRAY}Modular Environment Provisioning, State Diagnostics & Package Matrix${C_RESET}     ${C_DARK_G}║${C_RESET}"
    echo -e "${C_DARK_G}╚═══════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo ""
}

pause() {
    echo ""
    echo -e "${C_GRAY}Press [Enter] to continue...${C_RESET}"
    read -r || true
}

# ==============================================================================
# TOOL IMPLEMENTATIONS (CHECKS & INSTALLERS)
# ==============================================================================

# --- [ANDROID] ---
check_java21() {
    [ -d "$JAVA_PREFERRED_PATH" ] || (command -v java >/dev/null && java -version 2>&1 | grep -q "21\.")
}
install_java21() {
    echo -e "${C_MINT}Installing OpenJDK 21 LTS via apt...${C_RESET}"
    sudo apt update && sudo apt install -y openjdk-21-jdk
    sync_env
}

check_android_cmdline() {
    [ -x "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" ]
}
install_android_cmdline() {
    echo -e "${C_MINT}Downloading Android Command-Line Tools (sdkmanager)...${C_RESET}"
    mkdir -p "$ANDROID_DIR/cmdline-tools" /tmp
    local zip_file="/tmp/cmdline-tools.zip"
    curl -L -o "$zip_file" "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
    unzip -q -o "$zip_file" -d /tmp/cmdline-extract
    mkdir -p "$ANDROID_DIR/cmdline-tools/latest"
    cp -r /tmp/cmdline-extract/cmdline-tools/* "$ANDROID_DIR/cmdline-tools/latest/"
    rm -rf /tmp/cmdline-extract "$zip_file"
    sync_env
}

check_android_platform_tools() {
    [ -x "$ANDROID_DIR/platform-tools/adb" ] || command -v adb >/dev/null 2>&1
}
install_android_platform_tools() {
    echo -e "${C_MINT}Installing Android Platform-Tools (adb, fastboot)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "platform-tools"
}

check_android_platforms() {
    [ -d "$ANDROID_DIR/platforms/android-36" ] || [ -d "$ANDROID_DIR/platforms/android-34" ]
}
install_android_platforms() {
    echo -e "${C_MINT}Installing Android SDK Platforms (API 34 & 36)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "platforms;android-36" "platforms;android-34"
}

check_android_build_tools() {
    [ -d "$ANDROID_DIR/build-tools/28.0.3" ] || [ -d "$ANDROID_DIR/build-tools/34.0.0" ]
}
install_android_build_tools() {
    echo -e "${C_MINT}Installing Android Build-Tools (28.0.3 & 34.0.0)...${C_RESET}"
    check_android_cmdline || install_android_cmdline
    sync_env
    echo "y" | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" "build-tools;28.0.3" "build-tools;34.0.0"
}

check_flutter() {
    [ -x "$FLUTTER_DIR/bin/flutter" ] || command -v flutter >/dev/null 2>&1
}
install_flutter() {
    echo -e "${C_MINT}Cloning Flutter SDK (stable channel)...${C_RESET}"
    mkdir -p "$DEV_DIR"
    if [ ! -d "$FLUTTER_DIR" ]; then
        git clone https://github.com/flutter/flutter.git -b stable "$FLUTTER_DIR"
    else
        cd "$FLUTTER_DIR" && git pull || true
    fi
    sync_env
    "$FLUTTER_DIR/bin/flutter" precache
    "$FLUTTER_DIR/bin/flutter" config --android-sdk "$ANDROID_DIR" || true
    yes | "$ANDROID_DIR/cmdline-tools/latest/bin/sdkmanager" --licenses 2>/dev/null || true
}

# --- [IOS (LINUX TOOLS)] ---
check_usbmuxd() { command -v usbmuxd >/dev/null 2>&1; }
install_usbmuxd() {
    echo -e "${C_MINT}Installing usbmuxd (USB daemon for iOS devices)...${C_RESET}"
    sudo apt update && sudo apt install -y usbmuxd
}

check_libimobiledevice() {
    command -v ideviceinfo >/dev/null 2>&1 || dpkg -s libimobiledevice6 >/dev/null 2>&1
}
install_libimobiledevice() {
    echo -e "${C_MINT}Installing libimobiledevice communication stack...${C_RESET}"
    sudo apt update && sudo apt install -y libimobiledevice6 libimobiledevice-utils
}

check_ideviceinstaller() { command -v ideviceinstaller >/dev/null 2>&1; }
install_ideviceinstaller() {
    echo -e "${C_MINT}Installing ideviceinstaller...${C_RESET}"
    sudo apt update && sudo apt install -y ideviceinstaller
}

check_cocoapods() { command -v pod >/dev/null 2>&1; }
install_cocoapods() {
    echo -e "${C_MINT}Installing Ruby and CocoaPods...${C_RESET}"
    sudo apt update && sudo apt install -y ruby-full build-essential
    sudo gem install cocoapods || true
}

# --- [WEB DEVELOPMENT] ---
check_nodejs() { command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; }
install_nodejs() {
    echo -e "${C_MINT}Installing Node.js LTS and npm...${C_RESET}"
    curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -
    sudo apt install -y nodejs
}

check_pnpm_yarn() { command -v pnpm >/dev/null 2>&1 && command -v yarn >/dev/null 2>&1; }
install_pnpm_yarn() {
    echo -e "${C_MINT}Installing pnpm and yarn package managers...${C_RESET}"
    sudo npm install -g pnpm yarn
}

check_postgresql() { command -v psql >/dev/null 2>&1; }
install_postgresql() {
    echo -e "${C_MINT}Installing PostgreSQL server and client tools...${C_RESET}"
    sudo apt update && sudo apt install -y postgresql postgresql-contrib
    sudo systemctl enable --now postgresql || true
}

check_redis() { command -v redis-server >/dev/null 2>&1 && command -v redis-cli >/dev/null 2>&1; }
install_redis() {
    echo -e "${C_MINT}Installing Redis server and CLI...${C_RESET}"
    sudo apt update && sudo apt install -y redis-server redis-tools
    sudo systemctl enable --now redis-server || true
}

check_docker() { command -v docker >/dev/null 2>&1; }
install_docker() {
    echo -e "${C_MINT}Installing Docker Engine & Docker Compose plugin...${C_RESET}"
    sudo apt update && sudo apt install -y docker.io docker-compose-plugin docker-compose
    sudo systemctl enable --now docker || true
    sudo usermod -aG docker "$USER" || true
    echo -e "${C_EMERALD}Docker installed. Group activation applies on new terminal session.${C_RESET}"
}

check_chrome() { command -v google-chrome >/dev/null 2>&1 || command -v chromium >/dev/null 2>&1; }
install_chrome() {
    echo -e "${C_MINT}Installing Chromium Browser...${C_RESET}"
    sudo apt update && sudo apt install -y chromium
}

# --- [AI & MACHINE LEARNING] ---
check_python_env() {
    command -v python3 >/dev/null 2>&1 && command -v pip3 >/dev/null 2>&1
}
install_python_env() {
    echo -e "${C_MINT}Installing Python 3, pip, and venv tooling...${C_RESET}"
    sudo apt update && sudo apt install -y python3 python3-pip python3-venv python3-full
}

check_ollama() { command -v ollama >/dev/null 2>&1; }
install_ollama() {
    echo -e "${C_MINT}Installing Ollama (Local AI & LLM Runtime)...${C_RESET}"
    curl -fsSL https://ollama.com/install.sh | sh
}

check_jupyter() {
    command -v jupyter >/dev/null 2>&1 || python3 -c "import jupyterlab" >/dev/null 2>&1
}
install_jupyter() {
    echo -e "${C_MINT}Installing JupyterLab and Jupyter Notebook...${C_RESET}"
    python3 -m pip install --user --upgrade jupyterlab notebook --break-system-packages || true
}

check_ai_stack() {
    python3 -c "import numpy, pandas, sklearn" >/dev/null 2>&1
}
install_ai_stack() {
    echo -e "${C_MINT}Installing Core AI Stack (NumPy, Pandas, Scikit-Learn, PyTorch)...${C_RESET}"
    python3 -m pip install --user --upgrade numpy pandas scikit-learn matplotlib scipy torch torchvision --break-system-packages || true
}

check_huggingface() {
    command -v huggingface-cli >/dev/null 2>&1 || python3 -c "import huggingface_hub" >/dev/null 2>&1
}
install_huggingface() {
    echo -e "${C_MINT}Installing Hugging Face Hub CLI...${C_RESET}"
    python3 -m pip install --user --upgrade "huggingface_hub[cli]" --break-system-packages || true
}

# --- [DEVELOPMENT SOFTWARES] ---
check_vscode() { command -v code >/dev/null 2>&1 || command -v code-oss >/dev/null 2>&1; }
install_vscode() {
    echo -e "${C_MINT}Installing Visual Studio Code...${C_RESET}"
    local deb_path="/tmp/vscode.deb"
    curl -L -o "$deb_path" "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"
    sudo apt install -y "$deb_path" || sudo dpkg -i "$deb_path" || sudo apt install -f -y
    rm -f "$deb_path"
}

check_gh_cli() { command -v gh >/dev/null 2>&1; }
install_gh_cli() {
    echo -e "${C_MINT}Installing GitHub CLI (gh)...${C_RESET}"
    sudo mkdir -p -m 755 /etc/apt/keyrings
    wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
    sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update && sudo apt install -y gh
}

check_postman() { command -v postman >/dev/null 2>&1 || [ -d "/opt/Postman" ]; }
install_postman() {
    echo -e "${C_MINT}Installing Postman API Client...${C_RESET}"
    local tar_path="/tmp/postman.tar.gz"
    curl -L -o "$tar_path" "https://dl.pstmn.io/download/latest/linux_64"
    sudo tar -xzf "$tar_path" -C /opt
    sudo ln -sf /opt/Postman/Postman /usr/local/bin/postman
    rm -f "$tar_path"
    
    cat << EOF | sudo tee /usr/share/applications/postman.desktop > /dev/null
[Desktop Entry]
Name=Postman
GenericName=API Client
Comment=API Development Platform
Exec=/opt/Postman/Postman
Icon=/opt/Postman/app/resources/app/assets/icon.png
Terminal=false
Type=Application
Categories=Development;
EOF
    echo -e "${C_EMERALD}Postman installed successfully.${C_RESET}"
}

check_dbeaver() { command -v dbeaver >/dev/null 2>&1 || dpkg -s dbeaver-ce >/dev/null 2>&1; }
install_dbeaver() {
    echo -e "${C_MINT}Installing DBeaver Universal Database Manager...${C_RESET}"
    local deb_path="/tmp/dbeaver.deb"
    curl -L -o "$deb_path" "https://dbeaver.io/files/dbeaver-ce_latest_amd64.deb"
    sudo apt install -y "$deb_path" || sudo dpkg -i "$deb_path" || sudo apt install -f -y
    rm -f "$deb_path"
}

check_git_gui() { command -v git-cola >/dev/null 2>&1 || command -v gitk >/dev/null 2>&1; }
install_git_gui() {
    echo -e "${C_MINT}Installing Git GUI Tools (Git Cola, Gitk)...${C_RESET}"
    sudo apt update && sudo apt install -y git-cola gitk
}

check_tmux_htop() { command -v tmux >/dev/null 2>&1 && command -v htop >/dev/null 2>&1; }
install_tmux_htop() {
    echo -e "${C_MINT}Installing Tmux and Htop...${C_RESET}"
    sudo apt update && sudo apt install -y tmux htop
}

# --- [CORE SYSTEM & GIT] ---
check_git_configured() {
    command -v git >/dev/null 2>&1 && [ -n "$(git config --global user.name 2>/dev/null)" ]
}
install_git_configured() {
    echo -e "${C_MINT}Configuring Git Global Identity...${C_RESET}"
    read -rp "Enter Full Name: " g_name
    read -rp "Enter GitHub Email: " g_email
    [ -n "$g_name" ] && git config --global user.name "$g_name"
    [ -n "$g_email" ] && git config --global user.email "$g_email"
    git config --global init.defaultBranch main
}

check_github_ssh() { [ -f "$HOME/.ssh/id_ed25519" ]; }
install_github_ssh() {
    echo -e "${C_MINT}Generating Ed25519 SSH Key for GitHub...${C_RESET}"
    local email
    email=$(git config --global user.email 2>/dev/null || echo "developer@example.com")
    mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
    ssh-keygen -t ed25519 -C "$email" -f "$HOME/.ssh/id_ed25519" -N ""
    chmod 600 "$HOME/.ssh/id_ed25519"
    chmod 644 "$HOME/.ssh/id_ed25519.pub"
    echo -e "\n${C_EMERALD}Public Key (Copy to https://github.com/settings/keys):${C_RESET}"
    cat "$HOME/.ssh/id_ed25519.pub"
    echo ""
    read -rp "Press [Enter] to test connection..."
    ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -T git@github.com 2>&1 || true
}

check_build_essentials() {
    command -v clang >/dev/null 2>&1 && command -v cmake >/dev/null 2>&1 && command -v ninja >/dev/null 2>&1 && command -v pkg-config >/dev/null 2>&1
}
install_build_essentials() {
    echo -e "${C_MINT}Installing C/C++ Build Essentials and system libraries...${C_RESET}"
    sudo apt update && sudo apt install -y clang cmake ninja-build pkg-config build-essential libgtk-3-dev liblzma-dev mesa-utils curl git unzip zip xz-utils
}

